<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:dagangOnline.Mobile.ViewModels"
             x:Class="dagangOnline.Mobile.Views.HomePage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Label Text="Selamat Datang di dagangOnline" FontSize="20" FontAttributes="Bold" TextColor="#212529"/>
            <Label Text="Platform Marketplace UMKM &amp; Layanan Mitra Terpercaya di Indonesia." FontSize="13" TextColor="#6C757D"/>

            <Label Text="Kategori Utama" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>
            <CollectionView ItemsSource="{Binding FeaturedCategories}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,4" BackgroundColor="#F8F9FA" StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding .}" FontSize="14" FontAttributes="SemiBold" TextColor="#0D6EFD"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
