@page
@model dagangOnline.Pages.PartnershipModel
@{
    ViewData["Title"] = "Program Kemitraan Sahabat UMKM";
}

<div class="container py-5">
    <!-- Hero Section -->
    <div class="row align-items-center mb-5 pb-3">
        <div class="col-lg-7">
            <span class="badge bg-warning bg-opacity-25 text-dark fw-semibold px-3 py-2 rounded-pill mb-3">
                🤝 Program Kemitraan & Gotong Royong
            </span>
            <h1 class="display-4 fw-bold mb-3 text-dark">
                Bertumbuh Bersama Keluarga Besar <span class="text-primary">dagangOnline</span>
            </h1>
            <p class="lead text-muted mb-4">
                Bergabunglah sebagai Toko Sahabat, Mitra Usaha, atau Pendamping Wirausaha Lokal. Dapatkan akses ke pembeli lebih luas, bantuan pengelolaan toko yang ramah, dan kerja sama yang saling menguntungkan.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-page="/Account/Register" asp-route-role="mitra" class="btn btn-primary btn-lg px-4 fw-semibold shadow-sm rounded-pill">
                    Daftar Sebagai Mitra
                </a>
                <a asp-page="/Contact" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                    Ngobrol Santai Bersama Kami
                </a>
            </div>
        </div>
        <div class="col-lg-5 text-center mt-4 mt-lg-0">
            <div class="card border-0 shadow-lg p-4 bg-gradient bg-primary text-white rounded-4">
                <div class="card-body">
                    <div class="display-3 fw-bold mb-2">@(Model.ActiveMitraCount > 0 ? Model.ActiveMitraCount.ToString() : "50+")</div>
                    <h5 class="fw-semibold mb-3">Toko & Mitra Terdaftar</h5>
                    <p class="small text-white-50 mb-4">
                        Tergabung dalam wadah gotong royong pelaku usaha lokal di berbagai daerah.
                    </p>
                    <div class="row g-2 text-dark text-start">
                        <div class="col-6">
                            <div class="p-2 bg-white rounded-3">
                                <span class="d-block small text-muted">Bagi Hasil Usaha</span>
                                <strong class="fs-6">Transparan & Adil</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 bg-white rounded-3">
                                <span class="d-block small text-muted">Pencairan Dana</span>
                                <strong class="fs-6">Cepat & Tanpa Ribet</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Keuntungan Menjadi Mitra -->
    <div class="mb-5 pb-4">
        <div class="text-center mb-5">
            <h2 class="h3 fw-bold">Kemudahan Bergabung Bersama Kami</h2>
            <p class="text-muted">Dukungan nyata yang kami siapkan agar usaha Anda makin laris dan berkembang</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white">
                    <div class="card-body">
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 d-inline-block mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-shop-window" viewBox="0 0 16 16">
                                <path d="M2.97 1.35A1 1 0 0 1 3.73 1h8.54a1 1 0 0 1 .76.35l2.609 3.044A1.5 1.5 0 0 1 16 5.37v.255a2.375 2.375 0 0 1-4.25 1.458A2.371 2.371 0 0 1 9.875 8 2.37 2.37 0 0 1 8 7.083 2.37 2.37 0 0 1 6.125 8a2.37 2.37 0 0 1-1.875-.917A2.375 2.375 0 0 1 0 5.625V5.37a1.5 1.5 0 0 1 .361-.976l2.61-3.045zm1.78 4.275a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 1 0 2.75 0V5.37a.5.5 0 0 0-.12-.325L12.27 2H3.73L1.12 5.045A.5.5 0 0 0 1 5.37v.255a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0zM1.5 8.5A.5.5 0 0 1 2 9v6h12V9a.5.5 0 0 1 1 0v6h1a.5.5 0 0 1 0 1H0a.5.5 0 0 1 0-1h1V9a.5.5 0 0 1 .5-.5zm2 .5a.5.5 0 0 1 .5.5V13h8V9.5a.5.5 0 0 1 1 0V13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5a.5.5 0 0 1 .5-.5z"/>
                            </svg>
                        </div>
                        <h4 class="h5 fw-bold mb-2">Jangkauan Pembeli Lebih Luas</h4>
                        <p class="text-muted small">
                            Produk dan layanan Anda akan langsung dapat ditemukan oleh tetangga, warga sekitar, dan pelanggan baru di platform.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white">
                    <div class="card-body">
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 d-inline-block mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-chat-heart" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M2.965 12.695a1 1 0 0 0-.287-.438l-.666-.666a4.5 4.5 0 0 1 0-6.364l.666-.666a1 1 0 0 0 .287-.438l.192-.768a1 1 0 0 1 .73-.73l.768-.192a1 1 0 0 0 .438-.287l.666-.666a4.5 4.5 0 0 1 6.364 0l.666.666a1 1 0 0 0 .438.287l.768.192a1 1 0 0 1 .73.73l.192.768a1 1 0 0 0 .287.438l.666.666a4.5 4.5 0 0 1 0 6.364l-.666.666a1 1 0 0 0-.287.438l-.192.768a1 1 0 0 1-.73.73l-.768.192a1 1 0 0 0-.438.287l-.666.666a4.5 4.5 0 0 1-6.364 0l-.666-.666a1 1 0 0 0-.438-.287l-.768-.192a1 1 0 0 1-.73-.73l-.192-.768zM8 4.5c-.886 0-1.6.714-1.6 1.6 0 .463.195.882.508 1.182L8 8.39l1.092-1.108A1.597 1.597 0 0 0 9.6 6.1c0-.886-.714-1.6-1.6-1.6z"/>
                            </svg>
                        </div>
                        <h4 class="h5 fw-bold mb-2">Didampingi dengan Ramah</h4>
                        <p class="text-muted small">
                            Tidak perlu takut gaptek! Tim kami siap memandu cara memasukkan foto produk dan melayani pesanan dari ponsel.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white">
                    <div class="card-body">
                        <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 d-inline-block mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-shield-check" viewBox="0 0 16 16">
                                <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                                <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                            </svg>
                        </div>
                        <h4 class="h5 fw-bold mb-2">Pencatatan Jujur & Jelas</h4>
                        <p class="text-muted small">
                            Setiap transaksi tercatat transparan, dana jualan Anda terlindungi dan dapat dicairkan kapan saja dengan tenang.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tipe Kemitraan -->
    <div class="card border-0 shadow-sm p-4 bg-light mb-5 rounded-4">
        <div class="card-body">
            <h3 class="h4 fw-bold mb-4 text-center">Bentuk Kemitraan yang Terbuka untuk Anda</h3>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="p-4 bg-white rounded-4 h-100 shadow-sm">
                        <span class="badge bg-primary mb-2 rounded-pill">Mitra Toko & Warung</span>
                        <h5 class="fw-bold">Warung & Toko Kelontong</h5>
                        <p class="text-muted small mb-0">Untuk warung sembako, toko harian, dan pedagang keliling yang ingin terima pesanan warga lewat online.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 bg-white rounded-4 h-100 shadow-sm">
                        <span class="badge bg-success mb-2 rounded-pill">Mitra Kuliner & UMKM</span>
                        <h5 class="fw-bold">Kuliner & Usaha Rumahan</h5>
                        <p class="text-muted small mb-0">Untuk penjual makanan, jajanan pasar, kedai kopi, dan pengrajin oleh-oleh lokal agar makin laris manis.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 bg-white rounded-4 h-100 shadow-sm">
                        <span class="badge bg-warning text-dark mb-2 rounded-pill">Mitra Jasa & Kurir</span>
                        <h5 class="fw-bold">Jasa & Kurir Lingkungan</h5>
                        <p class="text-muted small mb-0">Untuk kurir antar-tetangga, jasa antar pesanan, atau tukang servis lokal yang ingin melayani warga sekitar.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Call To Action -->
    <div class="p-5 text-center bg-dark text-white rounded-4 shadow">
        <h2 class="display-6 fw-bold mb-3">Siap Menjadi Bagian dari Sahabat dagangOnline?</h2>
        <p class="lead text-light mb-4 col-md-8 mx-auto">
            Pendaftaran mudah, gratis, dan ramah pemula. Mari kita majukan usaha warga bersama-sama dengan penuh semangat gotong royong.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-page="/Account/Register" asp-route-role="mitra" class="btn btn-warning btn-lg px-4 fw-bold text-dark rounded-pill">
                Daftar Mitra Sekarang
            </a>
            <a asp-page="/Contact" class="btn btn-outline-light btn-lg px-4 rounded-pill">
                Tanya-Tanya Dulu
            </a>
        </div>
    </div>
</div>
