@page
@model dagangOnline.Pages.PartnershipModel
@{
    ViewData["Title"] = "Program Kemitraan (Partnership)";
}

<div class="container py-5">
    <!-- Hero Section -->
    <div class="row align-items-center mb-5 pb-3">
        <div class="col-lg-7">
            <span class="badge bg-warning bg-opacity-25 text-dark fw-semibold px-3 py-2 rounded-pill mb-3">
                🤝 Program Kemitraan & Kolaborasi
            </span>
            <h1 class="display-4 fw-bold mb-3 text-dark">
                Bertumbuh Bersama Ekosistem <span class="text-primary">dagangOnline</span>
            </h1>
            <p class="lead text-muted mb-4">
                Bergabunglah sebagai Mitra Pengembang, Agensi Solusi, atau Penyedia Layanan Digital. Dapatkan akses ke ratusan peluang proyek, integrasi API terpadu, dan bagi hasil transparan.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-page="/Account/Register" asp-route-role="mitra" class="btn btn-primary btn-lg px-4 fw-semibold shadow-sm">
                    Daftar Sebagai Mitra
                </a>
                <a asp-page="/Contact" class="btn btn-outline-secondary btn-lg px-4">
                    Konsultasi Kemitraan
                </a>
            </div>
        </div>
        <div class="col-lg-5 text-center mt-4 mt-lg-0">
            <div class="card border-0 shadow-lg p-4 bg-gradient bg-primary text-white rounded-4">
                <div class="card-body">
                    <div class="display-3 fw-bold mb-2">@(Model.ActiveMitraCount > 0 ? Model.ActiveMitraCount.ToString() : "50+")</div>
                    <h5 class="fw-semibold mb-3">Mitra Terverifikasi Aktif</h5>
                    <p class="small text-white-50 mb-4">
                        Tergabung dalam jaringan penyedia solusi teknologi terpercaya di seluruh Indonesia.
                    </p>
                    <div class="row g-2 text-dark text-start">
                        <div class="col-6">
                            <div class="p-2 bg-white rounded-3">
                                <span class="d-block small text-muted">Komisi Proyek</span>
                                <strong class="fs-6">Hingga 85%</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 bg-white rounded-3">
                                <span class="d-block small text-muted">Pencairan</span>
                                <strong class="fs-6">Mingguan / Real-time</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Keuntungan Menjadi Mitra -->
    <div class="mb-5 pb-4">
        <div class="text-center mb-5">
            <h2 class="h3 fw-bold">Mengapa Bergabung Sebagai Mitra dagangOnline?</h2>
            <p class="text-muted">Infrastruktur dan kemudahan yang kami sediakan untuk mendukung akselerasi bisnis Anda</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3 rounded-3">
                    <div class="card-body">
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 d-inline-block mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-briefcase" viewBox="0 0 16 16">
                                <path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5zm1.886 6.914L15 7.151V12.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5V7.15l6.614 1.764a1.5 1.5 0 0 0 .772 0zM1.5 4h13a.5.5 0 0 1 .5.5v1.616L8.129 7.948a.5.5 0 0 1-.258 0L1 6.116V4.5a.5.5 0 0 1 .5-.5z"/>
                            </svg>
                        </div>
                        <h4 class="h5 fw-bold mb-2">Akses Proyek Berkualitas</h4>
                        <p class="text-muted small">
                            Klien terverifikasi dari sektor UMKM hingga korporasi yang siap mengimplementasikan solusi digital Anda.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3 rounded-3">
                    <div class="card-body">
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 d-inline-block mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-code-slash" viewBox="0 0 16 16">
                                <path d="M10.478 1.647a.5.5 0 1 0-.956-.294l-4 13a.5.5 0 0 0 .956.294l4-13zM4.854 4.146a.5.5 0 0 1 0 .708L1.707 8l3.147 3.146a.5.5 0 0 1-.708.708l-3.5-3.5a.5.5 0 0 1 0-.708l3.5-3.5a.5.5 0 0 1 .708 0zm6.292 0a.5.5 0 0 0 0 .708L14.293 8l-3.147 3.146a.5.5 0 0 0 .708.708l3.5-3.5a.5.5 0 0 0 0-.708l-3.5-3.5a.5.5 0 0 0-.708 0z"/>
                            </svg>
                        </div>
                        <h4 class="h5 fw-bold mb-2">API & Integrasi gRPC Lengkap</h4>
                        <p class="text-muted small">
                            Sambungkan sistem Anda langsung ke katalog, manajemen pesanan, dan analitik via REST API & gRPC siap pakai.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3 rounded-3">
                    <div class="card-body">
                        <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 d-inline-block mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-shield-check" viewBox="0 0 16 16">
                                <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                                <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                            </svg>
                        </div>
                        <h4 class="h5 fw-bold mb-2">Pembayaran Terproteksi</h4>
                        <p class="text-muted small">
                            Sistem escrow andal yang menjamin pembayaran jasa Anda tepat waktu setelah milestone terselesaikan.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tipe Kemitraan -->
    <div class="card border-0 shadow-sm p-4 bg-light mb-5 rounded-4">
        <div class="card-body">
            <h3 class="h4 fw-bold mb-4 text-center">Kategori Kemitraan Yang Tersedia</h3>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 h-100 shadow-sm">
                        <span class="badge bg-primary mb-2">Developer Partner</span>
                        <h5 class="fw-bold">Mitra Pengembang Aplikasi</h5>
                        <p class="text-muted small mb-0">Untuk freelancer & software house yang membangun web, mobile app, API backend, dan otomasi.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 h-100 shadow-sm">
                        <span class="badge bg-success mb-2">Agency Partner</span>
                        <h5 class="fw-bold">Mitra Agensi Digital</h5>
                        <p class="text-muted small mb-0">Untuk agensi marketing, SEO, branding, dan konsultan transformasi bisnis UMKM.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 h-100 shadow-sm">
                        <span class="badge bg-info text-dark mb-2">Infrastructure Partner</span>
                        <h5 class="fw-bold">Mitra Cloud & Keamanan</h5>
                        <p class="text-muted small mb-0">Penyedia hosting, audit penetrasi siber, integrasi payment gateway, dan DevOps.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Call To Action -->
    <div class="p-5 text-center bg-dark text-white rounded-4 shadow">
        <h2 class="display-6 fw-bold mb-3">Siap Melangkah Menjadi Mitra Strategis?</h2>
        <p class="lead text-light mb-4 col-md-8 mx-auto">
            Proses pendaftaran mudah hanya 2 menit. Daftarkan profil keahlian Anda sekarang dan mulai terima permintaan proyek.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-page="/Account/Register" asp-route-role="mitra" class="btn btn-warning btn-lg px-4 fw-bold text-dark">
                Daftar Mitra Sekarang
            </a>
            <a asp-page="/Contact" class="btn btn-outline-light btn-lg px-4">
                Hubungi Tim Partnership
            </a>
        </div>
    </div>
</div>
