@page
@model dagangOnline.Pages.Dashboard.User.IndexModel
@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1">Dashboard Pengguna</h1>
            <p class="text-muted mb-0">Selamat datang kembali, <strong>@Model.DisplayName</strong> (@Model.UserEmail)</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-sm-0">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newRequestModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle me-1" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
                Ajukan Layanan Baru
            </button>
            <a asp-page="/Account/Profile" class="btn btn-outline-secondary">
                Kelola Profil
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 bg-light">
                <div class="card-body d-flex align-items-center">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-folder-check" viewBox="0 0 16 16">
                            <path d="m.5 3 .04.87a1.99 1.99 0 0 0-.342 1.311l.637 7A2 2 0 0 0 2.826 14H9v-1H2.826a1 1 0 0 1-.995-.91l-.637-7A1 1 0 0 1 2.19 4h11.62a1 1 0 0 1 .996 1.09L14.54 8h1.005l.256-2.819A2 2 0 0 0 13.81 3H9.828a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 6.172 1H2.5a2 2 0 0 0-2 2zm5.672-1a1 1 0 0 1 .707.293L7.586 3H2.19c-.24 0-.47.042-.683.12L1.5 2.98a1 1 0 0 1 1-.98h3.672z"/>
                            <path d="M15.854 10.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708l1.146 1.147 2.646-2.647a.5.5 0 0 1 .708 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0 small">Permintaan Layanan Aktif</h6>
                        <h3 class="fw-bold mb-0 text-dark">@Model.ActiveRequestsCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 bg-light">
                <div class="card-body d-flex align-items-center">
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-3 me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-bell" viewBox="0 0 16 16">
                            <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5.002 5.002 0 0 1 13 6c0 .88.32 4.2 1.22 6z"/>
                        </svg>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0 small">Notifikasi Baru</h6>
                        <h3 class="fw-bold mb-0 text-dark">@Model.UnreadNotificationsCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 bg-light">
                <div class="card-body d-flex align-items-center">
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-chat-left-dots" viewBox="0 0 16 16">
                            <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                            <path d="M5 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0 small">Total Inquiri</h6>
                        <h3 class="fw-bold mb-0 text-dark">@Model.ContactInquiries.Count</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Tabs -->
    <ul class="nav nav-pills mb-4" id="dashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" id="requests-tab" data-bs-toggle="pill" data-bs-target="#requests-pane" type="button" role="tab">
                Permintaan Layanan (@Model.ServiceRequests.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold position-relative" id="notifications-tab" data-bs-toggle="pill" data-bs-target="#notifications-pane" type="button" role="tab">
                Notifikasi
                @if (Model.UnreadNotificationsCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-1">@Model.UnreadNotificationsCount</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="inquiries-tab" data-bs-toggle="pill" data-bs-target="#inquiries-pane" type="button" role="tab">
                Riwayat Inquiri (@Model.ContactInquiries.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="dashboardTabsContent">
        <!-- Tab 1: Service Requests -->
        <div class="tab-pane fade show active" id="requests-pane" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Daftar Permintaan Layanan</h5>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#newRequestModal">
                        + Tambah Permintaan
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (Model.ServiceRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Judul Permintaan</th>
                                        <th>Layanan Terkait</th>
                                        <th>Perkiraan Budget</th>
                                        <th>Status</th>
                                        <th>Tanggal Pengajuan</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in Model.ServiceRequests)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="d-block text-dark">@req.Title</strong>
                                                <small class="text-muted">@req.Description</small>
                                            </td>
                                            <td>@(req.Service?.Name ?? "Konsultasi Umum")</td>
                                            <td>@(string.IsNullOrWhiteSpace(req.BudgetRange) ? "-" : req.BudgetRange)</td>
                                            <td>
                                                @if (req.Status == "New")
                                                {
                                                    <span class="badge bg-primary">Baru</span>
                                                }
                                                else if (req.Status == "In Progress")
                                                {
                                                    <span class="badge bg-warning text-dark">Sedang Dikerjakan</span>
                                                }
                                                else if (req.Status == "Completed")
                                                {
                                                    <span class="badge bg-success">Selesai</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@req.Status</span>
                                                }
                                            </td>
                                            <td class="text-muted small">@req.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <p class="text-muted mb-3">Anda belum memiliki permintaan layanan yang sedang diproses.</p>
                            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newRequestModal">
                                Ajukan Permintaan Pertama Anda
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Tab 2: Notifications -->
        <div class="tab-pane fade" id="notifications-pane" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">Kotak Masuk Notifikasi</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Notifications.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notif in Model.Notifications)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-start py-3 @(!notif.IsRead ? "bg-light" : "")">
                                    <div class="me-3">
                                        <div class="d-flex align-items-center mb-1">
                                            @if (!notif.IsRead)
                                            {
                                                <span class="badge bg-primary me-2">Baru</span>
                                            }
                                            <h6 class="fw-bold mb-0 text-dark">@notif.Title</h6>
                                        </div>
                                        <p class="text-muted mb-1 small">@notif.Message</p>
                                        <small class="text-muted">@notif.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                                    </div>
                                    @if (!notif.IsRead)
                                    {
                                        <form method="post" asp-page-handler="MarkNotificationRead" asp-route-notificationId="@notif.Id">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Tandai Dibaca</button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <p class="text-muted mb-0">Belum ada notifikasi.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Tab 3: Contact Inquiries History -->
        <div class="tab-pane fade" id="inquiries-pane" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">Riwayat Inquiri & Pesan Dikirim</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.ContactInquiries.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Subjek</th>
                                        <th>Kategori</th>
                                        <th>Status</th>
                                        <th>Waktu Kirim</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var inq in Model.ContactInquiries)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="d-block text-dark">@inq.Subject</strong>
                                                <small class="text-muted">@inq.Message</small>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@inq.Category</span></td>
                                            <td><span class="badge bg-info text-dark">@inq.Status</span></td>
                                            <td class="text-muted small">@inq.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <p class="text-muted mb-0">Belum ada riwayat pesan atau inquiri yang tercatat.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ajukan Permintaan Baru -->
<div class="modal fade" id="newRequestModal" tabindex="-1" aria-labelledby="newRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="newRequestModalLabel">Ajukan Permintaan Layanan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="CreateRequest">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewRequest.Title" class="form-label fw-semibold">Judul Permintaan <span class="text-danger">*</span></label>
                        <input asp-for="NewRequest.Title" class="form-control" placeholder="contoh: Pembuatan Toko Online & Aplikasi POS" />
                        <div class="form-text small text-muted">Ringkasan singkat mengenai proyek atau solusi yang diajukan.</div>
                        <span asp-validation-for="NewRequest.Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewRequest.ServiceId" class="form-label fw-semibold">Pilih Kategori Layanan</label>
                        <select asp-for="NewRequest.ServiceId" class="form-select">
                            <option value="">-- Layanan Umum / Kustom --</option>
                            @foreach (var svc in Model.AvailableServices)
                            {
                                <option value="@svc.Id">@svc.Name</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="NewRequest.BudgetRange" class="form-label fw-semibold">Perkiraan Budget</label>
                            <select asp-for="NewRequest.BudgetRange" class="form-select">
                                <option value="< 5 Juta">&lt; Rp 5 Juta</option>
                                <option value="5 - 15 Juta">Rp 5 - 15 Juta</option>
                                <option value="15 - 50 Juta">Rp 15 - 50 Juta</option>
                                <option value="> 50 Juta">&gt; Rp 50 Juta</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewRequest.Phone" class="form-label fw-semibold">No. WhatsApp/Telepon</label>
                            <input asp-for="NewRequest.Phone" class="form-control" placeholder="contoh: 081234567890" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewRequest.Description" class="form-label fw-semibold">Deskripsi Kebutuhan <span class="text-danger">*</span></label>
                        <textarea asp-for="NewRequest.Description" class="form-control" rows="4" placeholder="Jelaskan kebutuhan fungsional, sasaran bisnis, dan ekspektasi waktu pengerjaan..."></textarea>
                        <div class="form-text small text-muted">Detailkan spesifikasi atau preferensi teknologi yang Anda inginkan.</div>
                        <span asp-validation-for="NewRequest.Description" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Kirim Permintaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
