@page
@model dagangOnline.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1>Profile</h1>
        <p class="text-muted">Kelola informasi profil akun Anda.</p>

        @if (TempData["ProfileMessage"] is string message)
        {
            <div class="alert alert-success" role="status">@message</div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.DisplayName" class="form-label"></label>
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" readonly />
                <div class="form-text">Email dikelola oleh sistem Identity.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Bio" class="form-label"></label>
                <textarea asp-for="Input.Bio" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Input.Bio" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Simpan profile</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
