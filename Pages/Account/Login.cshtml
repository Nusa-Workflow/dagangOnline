@page
@model dagangOnline.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Masuk ke Akun";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4 text-center">
                    <span class="badge bg-white text-primary px-3 py-1 rounded-pill mb-2 fw-semibold">dagangOnline Portal</span>
                    <h3 class="fw-bold mb-1">Selamat Datang</h3>
                    <p class="text-white-50 small mb-0">Masuk untuk mengakses layanan, kemitraan, atau panel admin</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" id="emailInput" placeholder="contoh: budi@domain.com" autocomplete="username" />
                            <label asp-for="Input.Email">Alamat Email <span class="text-danger">*</span></label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label small fw-semibold text-muted">Kata Sandi <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Input.Password" type="password" class="form-control" id="passwordInput" placeholder="Masukkan kata sandi akun" autocomplete="current-password" />
                                <button class="btn btn-outline-secondary btn-toggle-password" type="button" data-target="passwordInput" aria-label="Tampilkan atau sembunyikan kata sandi">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                    </svg>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-slash d-none" viewBox="0 0 16 16">
                                        <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/>
                                        <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                                        <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z"/>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="Input.RememberMe" class="form-check-input" id="rememberMeCheck" />
                                <label asp-for="Input.RememberMe" class="form-check-label small text-muted" for="rememberMeCheck">Ingat Saya</label>
                            </div>
                            <a asp-page="/Contact" asp-route-category="Support" class="small text-decoration-none text-muted">Bantuan / Lupa sandi?</a>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold shadow-sm mb-3">
                            Masuk Sekarang
                        </button>
                    </form>

                    <!-- Quick Demo Credential Helper -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="fw-bold text-muted">Kredensial Demo Akun:</small>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 btn-demo-fill" data-demo-email="admin@dagangonline.local" data-demo-pass="Admin@123">
                                Admin (Super Admin)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 btn-demo-fill" data-demo-email="agent@dagangonline.local" data-demo-pass="Admin@123">
                                Agent (Moderator)
                            </button>
                        </div>
                        <div class="small text-muted font-monospace" style="font-size: 0.8rem;">
                            <div>Sandi Akun Demo: <strong>Admin@123</strong></div>
                        </div>
                    </div>

                    <div class="text-center">
                        <span class="text-muted small">Belum memiliki akun?</span>
                        <div class="d-flex justify-content-center gap-2 mt-2">
                            <a asp-page="/Account/Register" class="btn btn-sm btn-outline-secondary">Daftar Pengguna</a>
                            <a asp-page="/Account/Register" asp-route-role="mitra" class="btn btn-sm btn-outline-success">Daftar Mitra Bisnis</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
