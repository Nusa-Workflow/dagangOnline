@page
@model dagangOnline.Pages.SearchModel
@{
    ViewData["Title"] = "Pencarian";
}

<div class="container py-5">
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8 text-center">
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Eksplorasi</span>
            <h1 class="display-5 fw-bold mb-3">Pencarian Platform</h1>
            <p class="lead text-muted">Cari solusi layanan, studi kasus portfolio, atau produk digital kami</p>

            <form method="get" class="mt-4">
                <div class="input-group input-group-lg shadow-sm">
                    <input type="text" name="q" value="@Model.Q" class="form-control border-end-0" placeholder="Ketik kata kunci pencarian (cth: web, umkm, cloud)..." />
                    <button class="btn btn-primary px-4" type="submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-search me-1" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                        Cari
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Q))
    {
        <div class="mb-4 d-flex justify-content-between align-items-center">
            <h2 class="h5 text-muted mb-0">
                Menampilkan hasil pencarian untuk: <span class="fw-bold text-dark">"@Model.Q"</span>
            </h2>
            <span class="badge bg-secondary">@Model.Results.Count item ditemukan</span>
        </div>

        @if (Model.Results.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model.Results)
                {
                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold mb-0">@item.Title</h5>
                                    <span class="badge @(item.Type == "Service" ? "bg-info text-dark" : item.Type == "Portfolio" ? "bg-success" : "bg-warning text-dark")">
                                        @item.Type
                                    </span>
                                </div>
                                <p class="card-text text-muted mb-3">@item.Description</p>
                                <a href="@item.Url" class="btn btn-sm btn-outline-primary">Lihat Detail &rarr;</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border p-5 shadow-sm">
                <div class="p-3 bg-secondary bg-opacity-10 text-secondary rounded-circle d-inline-flex mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                    </svg>
                </div>
                <h3 class="h5 fw-bold text-dark mb-2">Tidak Ditemukan Hasil yang Cocok</h3>
                <p class="text-muted col-md-6 mx-auto mb-4">
                    Kata kunci "<strong>@Model.Q</strong>" belum cocok dengan data layanan atau portofolio kami. Coba kata kunci lain di bawah ini:
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-page="/Search" asp-route-q="Web" class="badge bg-light text-dark border p-2 text-decoration-none">Web</a>
                    <a asp-page="/Search" asp-route-q="UMKM" class="badge bg-light text-dark border p-2 text-decoration-none">UMKM</a>
                    <a asp-page="/Search" asp-route-q="Cloud" class="badge bg-light text-dark border p-2 text-decoration-none">Cloud</a>
                    <a asp-page="/Search" asp-route-q="Kasir" class="badge bg-light text-dark border p-2 text-decoration-none">Kasir</a>
                    <a asp-page="/Search" asp-route-q="API" class="badge bg-light text-dark border p-2 text-decoration-none">API</a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8 text-center text-muted py-5 bg-white rounded-4 border shadow-sm p-4">
                <h5 class="fw-bold text-dark mb-2">Pencarian Cepat di Seluruh Ekosistem</h5>
                <p class="small text-muted mb-4">Temukan layanan digital, katalog paket produk, dan studi kasus proyek dengan mengetikkan kata kunci atau klik saran pencarian populer berikut:</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-page="/Search" asp-route-q="Web" class="btn btn-sm btn-outline-primary">🌐 Web Development</a>
                    <a asp-page="/Search" asp-route-q="UMKM" class="btn btn-sm btn-outline-primary">🏪 Digitalisasi UMKM</a>
                    <a asp-page="/Search" asp-route-q="Cloud" class="btn btn-sm btn-outline-primary">☁️ Cloud & Keamanan</a>
                    <a asp-page="/Search" asp-route-q="Kasir" class="btn btn-sm btn-outline-primary">💳 Aplikasi Kasir / POS</a>
                    <a asp-page="/Search" asp-route-q="API" class="btn btn-sm btn-outline-primary">⚡ REST & gRPC API</a>
                </div>
            </div>
        </div>
    }
</div>
