@page
@model dagangOnline.Pages.ServicesModel
@{
    ViewData["Title"] = "Bantuan & Solusi Usaha";
}

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">
                🌟 Bantuan & Pendampingan
            </span>
            <h1 class="display-5 fw-bold">Bantuan & Layanan Usaha</h1>
            <p class="lead text-muted">Solusi praktis dan bersahabat yang kami siapkan untuk mendampingi warung dan UMKM berkembang</p>
        </div>

        @if (Model.PublishedServices.Any())
        {
            <div class="row g-4">
                @foreach (var service in Model.PublishedServices)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 rounded-4 p-3 bg-white">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-semibold text-dark">@service.Name</h5>
                                <p class="card-text text-muted flex-grow-1">@service.Summary</p>
                                @if (service.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark mb-2 align-self-start rounded-pill">⭐ Pilihan</span>
                                }
                                <a asp-page="/Contact" asp-route-category="Consultation" class="btn btn-outline-primary mt-auto rounded-pill">
                                    Tanya Layanan Ini &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border p-5 shadow-sm">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-grid-3x3-gap" viewBox="0 0 16 16">
                        <path d="M4 2v2H2V2h2zm1 12v-2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1zm0-5V7a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1zm0-5V2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1zm5 10v-2a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1zm0-5V7a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1zm0-5V2a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1zM9 2v2H7V2h2zm5 0v2h-2V2h2zM4 7v2H2V7h2zm5 0v2H7V7h2zm5 0v2h-2V7h2zM4 12v2H2v-2h2zm5 0v2H7v-2h2zm5 0v2h-2v-2h2z"/>
                    </svg>
                </div>
                <h3 class="h5 fw-bold text-dark mb-2">Katalog Sedang Kami Rapikan</h3>
                <p class="text-muted col-md-6 mx-auto mb-4">
                    Daftar solusi usaha sedang diperbarui agar semakin pas untuk kebutuhan Anda. Ingin bantuan untuk warung atau jualan produk lokal Anda sekarang? Mari ngobrol santai bersama kami.
                </p>
                <a asp-page="/Contact" class="btn btn-primary px-4 rounded-pill">Tanya & Konsultasi Gratis</a>
            </div>
        }
    </div>
</section>
