@page
@model dagangOnline.Pages.PortfolioModel
@{
    ViewData["Title"] = "Portfolio";
}

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold">Portfolio</h1>
            <p class="lead text-muted">Proyek dan solusi yang telah kami bangun</p>
        </div>

        @if (Model.FeaturedProjects.Any())
        {
            <div class="row g-4">
                @foreach (var project in Model.FeaturedProjects)
                {
                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h5 class="card-title fw-semibold">@project.Title</h5>
                                <p class="card-text text-muted">@project.Summary</p>

                                @if (!string.IsNullOrWhiteSpace(project.Problem))
                                {
                                    <div class="mb-2">
                                        <strong class="text-danger">Masalah:</strong>
                                        <span>@project.Problem</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.Solution))
                                {
                                    <div class="mb-2">
                                        <strong class="text-success">Solusi:</strong>
                                        <span>@project.Solution</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.Result))
                                {
                                    <div class="mb-2">
                                        <strong class="text-primary">Hasil:</strong>
                                        <span>@project.Result</span>
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-transparent border-0 pb-3">
                                @if (project.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark">⭐ Featured</span>
                                }
                                <small class="text-muted float-end">@project.CreatedAt.ToString("MMM yyyy")</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted fs-5">Belum ada portfolio yang tersedia saat ini.</p>
            </div>
        }
    </div>
</section>
