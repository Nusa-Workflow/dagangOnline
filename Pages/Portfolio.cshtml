@page
@model dagangOnline.Pages.PortfolioModel
@{
    ViewData["Title"] = "Cerita Sukses Sahabat UMKM";
}

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">
                📖 Kisah & Pengalaman
            </span>
            <h1 class="display-5 fw-bold">Cerita Sukses Sahabat UMKM</h1>
            <p class="lead text-muted">Kisah nyata teman-teman pedagang, warung, dan perintis usaha yang tumbuh bersama kami</p>
        </div>

        @if (Model.FeaturedProjects.Any())
        {
            <div class="row g-4">
                @foreach (var project in Model.FeaturedProjects)
                {
                    <div class="col-md-6">
                        <div class="card h-100 shadow-sm border-0 rounded-4 p-4 bg-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold text-dark mb-0">@project.Title</h5>
                                    @if (project.IsFeatured)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill">⭐ Pilihan</span>
                                    }
                                </div>
                                <p class="card-text text-muted mb-3">@project.Summary</p>

                                @if (!string.IsNullOrWhiteSpace(project.Problem))
                                {
                                    <div class="mb-2 p-2 bg-light rounded-3 small">
                                        <strong class="text-secondary">Tantangan Awal:</strong>
                                        <span class="text-muted">@project.Problem</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.Solution))
                                {
                                    <div class="mb-2 p-2 bg-light rounded-3 small">
                                        <strong class="text-primary">Langkah Kami:</strong>
                                        <span class="text-muted">@project.Solution</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.Result))
                                {
                                    <div class="mb-2 p-2 bg-success bg-opacity-10 rounded-3 small">
                                        <strong class="text-success">Hasil Membahagiakan:</strong>
                                        <span class="text-success">@project.Result</span>
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0">
                                <small class="text-muted float-end">@project.CreatedAt.ToString("MMM yyyy")</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border p-5 shadow-sm">
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle d-inline-flex mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-chat-square-heart" viewBox="0 0 16 16">
                        <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-2.5a2 2 0 0 0-1.6.8L8 14.333 6.1 11.8a2 2 0 0 0-1.6-.8H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2.5a1 1 0 0 1 .8.4l1.9 2.533a1 1 0 0 0 1.6 0l1.9-2.533a1 1 0 0 1 .8-.4H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                        <path d="M8 3.993c1.664-1.711 5.825 1.283 0 5.132-5.825-3.85-1.664-6.843 0-5.132z"/>
                    </svg>
                </div>
                <h3 class="h5 fw-bold text-dark mb-2">Kisah-Kisah Seru Sedang Dirapikan</h3>
                <p class="text-muted col-md-6 mx-auto mb-4">
                    Cerita dan pengalaman teman-teman UMKM sedang kami kumpulkan. Ingin membagikan kisah usaha Anda atau butuh bantuan jualan online?
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-page="/Services" class="btn btn-outline-primary rounded-pill px-4">Lihat Solusi Usaha</a>
                    <a asp-page="/Contact" class="btn btn-primary rounded-pill px-4">Ngobrol Bersama Kami</a>
                </div>
            </div>
        }
    </div>
</section>
