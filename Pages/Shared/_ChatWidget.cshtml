@using Microsoft.AspNetCore.Identity
@using dagangOnline.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User) && !User.IsInRole("Agent") && !User.IsInRole("Admin"))
{
    <div id="liveChatWidget" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050; display: flex; flex-direction: column; align-items: flex-end;">
        <!-- Chat Box -->
        <div id="chatBoxContainer" class="card shadow-lg border-0 d-none" style="width: 350px; height: 450px; display: flex; flex-direction: column; border-radius: 12px; overflow: hidden; margin-bottom: 15px;">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-robot" viewBox="0 0 16 16">
                        <path d="M6 12.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5ZM3 8.062C3 6.76 4.235 5.765 5.53 5.889a2.89 2.89 0 0 0 4.94 0C11.765 5.765 13 6.76 13 8.062v1.157a.933.933 0 0 1-.765.935c-.845.147-2.34.346-4.235.346-1.895 0-3.39-.2-4.235-.346A.933.933 0 0 1 3 9.219V8.062Zm4.542-.827a.25.25 0 0 0-.217.068l-.92.9a24.767 24.767 0 0 1-1.871-.183.25.25 0 0 0-.068.495c.55.076 1.232.149 2.02.193a.25.25 0 0 0 .189-.071l.754-.736.847 1.71a.25.25 0 0 0 .404.062l.932-.97a25.286 25.286 0 0 0 1.922-.188.25.25 0 0 0-.068-.495c-.538.074-1.208.145-1.98.189a.25.25 0 0 0-.166.076l-.754.785-.842-1.7a.25.25 0 0 0-.182-.135Z"/>
                        <path d="M8.5 1.866a1 1 0 1 0-1 0V3h-2A4.5 4.5 0 0 0 1 7.5V8a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1v-.5A4.5 4.5 0 0 0 10.5 3h-2V1.866ZM14 7.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7.5A3.5 3.5 0 0 1 5.5 4h5A3.5 3.5 0 0 1 14 7.5Z"/>
                    </svg>
                    <h6 class="mb-0 fw-bold">Live Support</h6>
                </div>
                <div>
                    <button type="button" class="btn-close btn-close-white" id="closeChatBtn" aria-label="Tutup"></button>
                </div>
            </div>
            <div id="chatMessages" class="card-body bg-light overflow-auto p-3" style="flex: 1;">
                <div class="d-flex mb-3 justify-content-start">
                    <div class="p-2 rounded shadow-sm bg-light border me-auto" style="max-width: 75%;">
                        <strong class="d-block small mb-1">Bot DagangOnline</strong>
                        <span>Halo! Ada yang bisa saya bantu hari ini? Anda bisa meminta bantuan agen jika diperlukan.</span>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white p-2">
                <button type="button" class="btn btn-sm btn-outline-warning w-100 mb-2 fw-semibold" id="btnEscalateChat">Eskalasi ke Agen</button>
                <form id="chatForm" class="d-flex gap-2">
                    <input type="text" id="chatMessageInput" class="form-control form-control-sm border-0 bg-light" placeholder="Ketik pesan..." autocomplete="off">
                    <button type="submit" id="btnSendChat" class="btn btn-sm btn-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send-fill" viewBox="0 0 16 16">
                            <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083l6-15Zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471-.47 1.178Z"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

        <!-- Chat Trigger Button -->
        <button id="chatTriggerBtn" class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-chat-dots-fill" viewBox="0 0 16 16">
                <path d="M16 8c0 3.866-3.582 7-8 7a9.06 9.06 0 0 1-2.347-.306c-.584.296-1.925.864-4.181 1.234-.2.032-.352-.176-.273-.362.354-.836.674-1.95.77-2.966C.744 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7zM5 8a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
            </svg>
        </button>
    </div>

    <!-- Inject SignalR Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var chatBoxContainer = document.getElementById("chatBoxContainer");
            var chatTriggerBtn = document.getElementById("chatTriggerBtn");
            var closeChatBtn = document.getElementById("closeChatBtn");

            if (chatTriggerBtn && chatBoxContainer) {
                chatTriggerBtn.addEventListener("click", function() {
                    chatBoxContainer.classList.remove("d-none");
                    chatTriggerBtn.classList.add("d-none");
                });
            }

            if (closeChatBtn && chatBoxContainer) {
                closeChatBtn.addEventListener("click", function() {
                    chatBoxContainer.classList.add("d-none");
                    chatTriggerBtn.classList.remove("d-none");
                });
            }
        });
    </script>
}
