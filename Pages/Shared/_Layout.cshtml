    <!-- A/B Testing & Push Messaging: OneSignal SDK -->
    <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
    <script>
        window.OneSignalDeferred = window.OneSignalDeferred || [];
        OneSignalDeferred.push(async function(OneSignal) {
            await OneSignal.init({
                appId: "ONESIGNAL-APP-ID-PLACEHOLDER",
                safari_web_id: "web.onesignal.auto.placeholder",
                notifyButton: {
                    enable: false,
                },
                allowLocalhostAsSecureOrigin: true,
            });
        });
    </script>

    <!-- Customer Data Platform: Wootric In-App NPS & Customer Intelligence -->
    <script type="text/javascript" src="https://cdn.wootric.com/wootric-sdk.js"></script>
    <script type="text/javascript">
        window.wootricSettings = {
            email: '@(User.Identity?.Name ?? "pengunjung@dagangonline.local")',
            created_at: 1773800000,
            account_token: 'NPS-DAGANGONLINE-DEMO'
        };
        window.wootric_survey_immediately = false;
        window.runWootricSurvey = function() {
            if (window.wootric) {
                window.wootric.run();
            }
        };
    </script>
</body>
</html>
