@page
@model dagangOnline.Pages.Agent.IndexModel
@{
    ViewData["Title"] = "Antrean Moderasi Produk — Human Agent";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0">Antrean Moderasi Produk</h1>
                <span class="badge bg-primary">Human Agent</span>
            </div>
            <p class="text-muted mb-0">Verifikasi dan kurasi pengajuan produk/paket solusi dari Mitra sebelum tayang ke publik.</p>
        </div>
        <div class="mt-2 mt-sm-0">
            <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                Menunggu Review: <strong>@Model.QueueItems.Count</strong> item
            </span>
        </div>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Daftar Pengajuan Menunggu Keputusan</h5>
            <span class="text-muted small">Diurutkan dari pengajuan terbaru</span>
        </div>
        <div class="card-body p-0">
            @if (Model.QueueItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Produk / Solusi</th>
                                <th>Kategori</th>
                                <th>Mitra Pengaju</th>
                                <th>Harga Usulan</th>
                                <th>Tanggal Masuk</th>
                                <th class="text-end pe-3">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.QueueItems)
                            {
                                <tr>
                                    <td>
                                        <strong class="d-block text-dark">@item.ProductName</strong>
                                        <small class="text-muted">@item.ProductSummary</small>
                                    </td>
                                    <td><span class="badge bg-secondary">@item.Category</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-sm bg-light text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 13px;">
                                                @(string.IsNullOrWhiteSpace(item.OwnerName) ? "M" : item.OwnerName[0].ToString().ToUpper())
                                            </div>
                                            <div>
                                                <div class="small fw-semibold">@(item.OwnerName ?? "Mitra Terdaftar")</div>
                                                <div class="text-muted" style="font-size: 11px;">ID: @(item.OwnerId?.Substring(0, Math.Min(8, item.OwnerId.Length)) ?? "-")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-semibold">
                                        @(item.Price > 0 ? $"Rp {item.Price:N0}" : "Hubungi Kami")
                                    </td>
                                    <td class="text-muted small">@item.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                                    <td class="text-end pe-3">
                                        <a asp-page="/Agent/Review" asp-route-id="@item.TaskId" class="btn btn-sm btn-outline-primary fw-semibold">
                                            Review & Keputusan &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="text-success mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-check-circle" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">Semua Bersih!</h5>
                    <p class="text-muted mb-0">Tidak ada pengajuan produk Mitra yang menunggu moderasi saat ini.</p>
                </div>
            }
        </div>
    </div>
</div>
