@page
@using dagangOnline.Domain.Chat
@model dagangOnline.Pages.Agent.LiveChatModel
@{
    ViewData["Title"] = "Live Chat Support";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Live Chat Support</h1>
            <p class="text-muted mb-0">Kelola percakapan pelanggan yang dieskalasi ke Anda.</p>
        </div>
    </div>

    <!-- Hidden input to indicate agent view to chat.js -->
    <input type="hidden" id="isAgentView" value="true" />

    <div class="row g-4">
        <!-- Sidebar: Session List -->
        <div class="col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Menunggu Agen (@Model.EscalatedSessions.Count)</h6>
                </div>
                <div class="list-group list-group-flush" id="escalatedSessionsList">
                    @if (Model.EscalatedSessions.Any())
                    {
                        foreach (var session in Model.EscalatedSessions)
                        {
                            <a href="?ActiveSessionId=@session.Id" class="list-group-item list-group-item-action py-3 @(Model.ActiveSessionId == session.Id ? "active" : "")">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold">@session.Customer?.DisplayName</h6>
                                    <small>@session.UpdatedAt.ToString("HH:mm")</small>
                                </div>
                                <div class="d-flex w-100 justify-content-between mt-1">
                                    <small class="mb-1 text-truncate">@session.Intent</small>
                                    <span class="badge bg-warning text-dark">@session.Priority</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted small">Tidak ada antrean eskalasi saat ini.</div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Sesi Aktif Saya (@Model.MyActiveSessions.Count)</h6>
                </div>
                <div class="list-group list-group-flush">
                    @if (Model.MyActiveSessions.Any())
                    {
                        foreach (var session in Model.MyActiveSessions)
                        {
                            <a href="?ActiveSessionId=@session.Id" class="list-group-item list-group-item-action py-3 @(Model.ActiveSessionId == session.Id ? "active" : "")">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold">@session.Customer?.DisplayName</h6>
                                    <small>@session.UpdatedAt.ToString("HH:mm")</small>
                                </div>
                                <div class="d-flex w-100 justify-content-between mt-1">
                                    <small class="mb-1 text-truncate text-success">@session.Status</small>
                                    <span class="badge bg-secondary">@session.Priority</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted small">Anda belum menangani sesi apa pun.</div>
                    }
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-lg-8 col-xl-9">
            <div class="card border-0 shadow-sm h-100 d-flex flex-column" style="min-height: 600px;">
                @if (Model.CurrentSession != null)
                {
                    <!-- Chat Header -->
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                @(Model.CurrentSession.Customer?.DisplayName?.FirstOrDefault().ToString() ?? "U")
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">
                                    @Model.CurrentSession.Customer?.DisplayName 
                                    <span class="badge bg-secondary ms-2">@Model.CurrentSession.Intent</span>
                                </h6>
                                <small class="text-muted">@Model.CurrentSession.Customer?.Email</small>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            @if (Model.CurrentSession.Status == ConversationStatus.Escalated || Model.CurrentSession.Status == ConversationStatus.Open)
                            {
                                <form method="post" asp-page-handler="AcceptEscalation">
                                    <input type="hidden" name="sessionId" value="@Model.CurrentSession.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Ambil Sesi</button>
                                </form>
                            }
                            else if (Model.CurrentSession.Status == ConversationStatus.WaitingForCustomer || Model.CurrentSession.Status == ConversationStatus.WaitingForAgent)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Prioritas: @Model.CurrentSession.Priority
                                    </button>
                                    <ul class="dropdown-menu">
                                        @foreach(var priority in Enum.GetValues(typeof(ConversationPriority)))
                                        {
                                            <li>
                                                <form method="post" asp-page-handler="UpdatePriority">
                                                    <input type="hidden" name="sessionId" value="@Model.CurrentSession.Id" />
                                                    <input type="hidden" name="newPriority" value="@priority" />
                                                    <button class="dropdown-item" type="submit">@priority</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Status: @Model.CurrentSession.Status
                                    </button>
                                    <ul class="dropdown-menu">
                                        @foreach(var status in Enum.GetValues(typeof(ConversationStatus)))
                                        {
                                            <li>
                                                <form method="post" asp-page-handler="UpdateStatus">
                                                    <input type="hidden" name="sessionId" value="@Model.CurrentSession.Id" />
                                                    <input type="hidden" name="newStatus" value="@status" />
                                                    <button class="dropdown-item" type="submit">@status</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Chat History -->
                    <div class="card-body bg-light overflow-auto p-4" id="chatMessages" style="flex: 1;">
                        @foreach (var msg in Model.CurrentSession.Messages.OrderBy(m => m.CreatedAt))
                        {
                            bool isMyMessage = msg.SenderType == SenderType.HumanAgent;
                            var msgClass = isMyMessage ? "bg-primary text-white ms-auto" : (msg.SenderType == SenderType.AI ? "bg-secondary text-white border me-auto" : "bg-white border me-auto");
                            var alignClass = isMyMessage ? "justify-content-end" : "justify-content-start";
                            var senderName = msg.SenderType == SenderType.Customer ? Model.CurrentSession.Customer?.DisplayName : (msg.SenderType == SenderType.HumanAgent ? "Anda" : "Bot");

                            <div class="d-flex mb-3 @alignClass">
                                <div class="p-3 rounded shadow-sm @msgClass" style="max-width: 75%;">
                                    @if (!isMyMessage)
                                    {
                                        <strong class="d-block small mb-1">@senderName</strong>
                                    }
                                    <span>@msg.Content</span>
                                    <small class="d-block mt-2 @(isMyMessage ? "text-white-50" : "text-muted")" style="font-size: 0.7rem; text-align: right;">@msg.CreatedAt.ToString("HH:mm")</small>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Chat Input -->
                    <div class="card-footer bg-white p-3">
                        @if (Model.CurrentSession.Status == ConversationStatus.WaitingForCustomer)
                        {
                            <form id="chatForm" class="d-flex gap-2">
                                <input type="text" id="chatMessageInput" class="form-control bg-light border-0" placeholder="Ketik balasan Anda..." autocomplete="off">
                                <button type="submit" id="btnSendChat" class="btn btn-primary px-4 d-flex align-items-center gap-2">
                                    <span>Kirim</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send-fill" viewBox="0 0 16 16">
                                        <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083l6-15Zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471-.47 1.178Z"/>
                                    </svg>
                                </button>
                            </form>
                        }
                        else if (Model.CurrentSession.Status == ConversationStatus.Escalated)
                        {
                            <div class="alert alert-warning mb-0 text-center">
                                Anda harus mengambil sesi ini terlebih dahulu untuk membalas pesan.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary mb-0 text-center">
                                Sesi obrolan ini telah selesai.
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-chat-square-dots mb-3 text-secondary opacity-50" viewBox="0 0 16 16">
                            <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-2.5a2 2 0 0 0-1.6.8L8 14.333 6.1 11.8a2 2 0 0 0-1.6-.8H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2.5a1 1 0 0 1 .8.4l1.9 2.533a1 1 0 0 0 1.6 0l1.9-2.533a1 1 0 0 1 .8-.4H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                            <path d="M5 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                        </svg>
                        <h5>Pilih sesi obrolan</h5>
                        <p>Pilih dari antrean di sebelah kiri untuk melihat detail atau mengambil alih sesi.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    <script>
        // Init agent session
        if (typeof currentSessionId !== 'undefined' && '@(Model.CurrentSession?.Id)') {
            currentSessionId = '@(Model.CurrentSession?.Id)';
        }

        // Scroll chat to bottom
        var chatBox = document.getElementById("chatMessages");
        if (chatBox) {
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function acceptEscalation(sessionId) {
            if (chatConnection.state === signalR.HubConnectionState.Connected) {
                chatConnection.invoke("AcceptEscalation", sessionId).then(function() {
                    // Reload page to reflect active status
                    window.location.href = "?ActiveSessionId=" + sessionId;
                }).catch(function (err) {
                    return console.error(err.toString());
                });
            } else {
                alert("Koneksi chat terputus. Menyambungkan kembali...");
            }
        }

        function endSession(sessionId) {
            if (confirm("Apakah Anda yakin ingin mengakhiri sesi chat ini?")) {
                chatConnection.invoke("EndSession", sessionId).then(function() {
                    window.location.href = "/Agent/LiveChat";
                }).catch(function (err) {
                    return console.error(err.toString());
                });
            }
        }

        // Agent-specific SignalR listeners
        chatConnection.on("SessionEscalated", function (sessionId, userId) {
            // Optional: Show toast or update badge
            var list = document.getElementById("escalatedSessionsList");
            if (list) {
                var noQueue = list.querySelector('.text-muted');
                if (noQueue) noQueue.remove();

                var html = `
                <a href="?ActiveSessionId=${sessionId}" class="list-group-item list-group-item-action py-3 bg-light">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1 fw-bold text-primary">Sesi Baru Masuk</h6>
                        <span class="badge bg-danger rounded-pill">New</span>
                    </div>
                    <p class="mb-1 small text-truncate">Menunggu bantuan agen...</p>
                </a>
                `;
                list.insertAdjacentHTML('afterbegin', html);
            }
        });
    </script>
}
