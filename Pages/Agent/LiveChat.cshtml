@page
@using dagangOnline.Domain.Chat
@model dagangOnline.Pages.Agent.LiveChatModel
@{
    ViewData["Title"] = "Live Chat Support";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Live Chat Support</h1>
            <p class="text-muted mb-0">Kelola percakapan pelanggan yang dieskalasi ke Anda.</p>
        </div>
    </div>

    <!-- Hidden input to indicate agent view to chat.js -->
    <input type="hidden" id="isAgentView" value="true" />

    <div class="row g-4">
        <!-- Sidebar: Session List -->
        <div class="col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Menunggu Agen (@Model.EscalatedSessions.Count)</h6>
                </div>
                <div class="list-group list-group-flush" id="escalatedSessionsList">
                    @if (Model.EscalatedSessions.Any())
                    {
                        foreach (var session in Model.EscalatedSessions)
                        {
                            <a href="?ActiveSessionId=@session.Id" class="list-group-item list-group-item-action py-3 @(Model.ActiveSessionId == session.Id ? "active" : "")">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold">@session.Customer?.DisplayName</h6>
                                    <small>@session.UpdatedAt.ToString("HH:mm")</small>
                                </div>
                                <div class="d-flex w-100 justify-content-between mt-1">
                                    <small class="mb-1 text-truncate">@session.Intent</small>
                                    <span class="badge bg-warning text-dark">@session.Priority</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted small">Tidak ada antrean eskalasi saat ini.</div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Sesi Aktif Saya (@Model.MyActiveSessions.Count)</h6>
                </div>
                <div class="list-group list-group-flush">
                    @if (Model.MyActiveSessions.Any())
                    {
                        foreach (var session in Model.MyActiveSessions)
                        {
                            <a href="?ActiveSessionId=@session.Id" class="list-group-item list-group-item-action py-3 @(Model.ActiveSessionId == session.Id ? "active" : "")">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold">@session.Customer?.DisplayName</h6>
                                    <small>@session.UpdatedAt.ToString("HH:mm")</small>
                                </div>
                                <div class="d-flex w-100 justify-content-between mt-1">
                                    <small class="mb-1 text-truncate text-success">@session.Status</small>
                                    <span class="badge bg-secondary">@session.Priority</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted small">Anda belum menangani sesi apa pun.</div>
                    }
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-lg-5 col-xl-5">
            <div class="card border-0 shadow-sm h-100 d-flex flex-column" style="min-height: 600px;">
                @if (Model.CurrentSession != null)
                {
                    <!-- Chat Header -->
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                @(Model.CurrentSession.Customer?.DisplayName?.FirstOrDefault().ToString() ?? "U")
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">
                                    @Model.CurrentSession.Customer?.DisplayName 
                                    <span class="badge bg-secondary ms-2">@Model.CurrentSession.Intent</span>
                                </h6>
                                <small class="text-muted">@Model.CurrentSession.Customer?.Email</small>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            @if (Model.CurrentSession.Status == ConversationStatus.Escalated || Model.CurrentSession.Status == ConversationStatus.Open)
                            {
                                <form method="post" asp-page-handler="AcceptEscalation">
                                    <input type="hidden" name="sessionId" value="@Model.CurrentSession.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Ambil Sesi</button>
                                </form>
                            }
                            else if (Model.CurrentSession.Status == ConversationStatus.WaitingForCustomer || Model.CurrentSession.Status == ConversationStatus.WaitingForAgent)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Prioritas: @Model.CurrentSession.Priority
                                    </button>
                                    <ul class="dropdown-menu">
                                        @foreach(var priority in Enum.GetValues(typeof(ConversationPriority)))
                                        {
                                            <li>
                                                <form method="post" asp-page-handler="UpdatePriority">
                                                    <input type="hidden" name="sessionId" value="@Model.CurrentSession.Id" />
                                                    <input type="hidden" name="newPriority" value="@priority" />
                                                    <button class="dropdown-item" type="submit">@priority</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Status: @Model.CurrentSession.Status
                                    </button>
                                    <ul class="dropdown-menu">
                                        @foreach(var status in Enum.GetValues(typeof(ConversationStatus)))
                                        {
                                            <li>
                                                <form method="post" asp-page-handler="UpdateStatus">
                                                    <input type="hidden" name="sessionId" value="@Model.CurrentSession.Id" />
                                                    <input type="hidden" name="newStatus" value="@status" />
                                                    <button class="dropdown-item" type="submit">@status</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Chat History -->
                    <div class="card-body bg-light overflow-auto p-4" id="chatMessages" style="flex: 1;">
                        @foreach (var msg in Model.CurrentSession.Messages.OrderBy(m => m.CreatedAt))
                        {
                            bool isMyMessage = msg.SenderType == SenderType.HumanAgent;
                            var msgClass = isMyMessage ? "bg-primary text-white ms-auto" : (msg.SenderType == SenderType.AI ? "bg-secondary text-white border me-auto" : "bg-white border me-auto");
                            var alignClass = isMyMessage ? "justify-content-end" : "justify-content-start";
                            var senderName = msg.SenderType == SenderType.Customer ? Model.CurrentSession.Customer?.DisplayName : (msg.SenderType == SenderType.HumanAgent ? "Anda" : "Bot");

                            <div class="d-flex mb-3 @alignClass">
                                <div class="p-3 rounded shadow-sm @msgClass" style="max-width: 75%;">
                                    @if (!isMyMessage)
                                    {
                                        <strong class="d-block small mb-1">@senderName</strong>
                                    }
                                    <span>@msg.Content</span>
                                    <small class="d-block mt-2 @(isMyMessage ? "text-white-50" : "text-muted")" style="font-size: 0.7rem; text-align: right;">@msg.CreatedAt.ToString("HH:mm")</small>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Chat Input -->
                    <div class="card-footer bg-white p-3">
                        @if (Model.CurrentSession.Status == ConversationStatus.WaitingForCustomer)
                        {
                            <form id="chatForm" class="d-flex gap-2">
                                <input type="text" id="chatMessageInput" class="form-control bg-light border-0" placeholder="Ketik balasan Anda..." autocomplete="off">
                                <button type="submit" id="btnSendChat" class="btn btn-primary px-4 d-flex align-items-center gap-2">
                                    <span>Kirim</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send-fill" viewBox="0 0 16 16">
                                        <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083l6-15Zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471-.47 1.178Z"/>
                                    </svg>
                                </button>
                            </form>
                        }
                        else if (Model.CurrentSession.Status == ConversationStatus.Escalated)
                        {
                            <div class="alert alert-warning mb-0 text-center">
                                Anda harus mengambil sesi ini terlebih dahulu untuk membalas pesan.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary mb-0 text-center">
                                Sesi obrolan ini telah selesai.
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-chat-square-dots mb-3 text-secondary opacity-50" viewBox="0 0 16 16">
                            <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-2.5a2 2 0 0 0-1.6.8L8 14.333 6.1 11.8a2 2 0 0 0-1.6-.8H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2.5a1 1 0 0 1 .8.4l1.9 2.533a1 1 0 0 0 1.6 0l1.9-2.533a1 1 0 0 1 .8-.4H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                            <path d="M5 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                        </svg>
                        <h5>Pilih sesi obrolan</h5>
                        <p>Pilih dari antrean di sebelah kiri untuk melihat detail atau mengambil alih sesi.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Voice & Economic Intelligence Copilots -->
        <div class="col-lg-4 col-xl-4">
            <!-- Nemotron VoiceChat-11B & Acoustic Telemetry Copilot Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header py-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #102A1E 0%, #1B4D3E 100%);">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning text-dark fw-bold">NVIDIA Nemotron + Qwen</span>
                        <h6 class="mb-0 fw-bold">Voice &amp; Acoustic Copilot</h6>
                    </div>
                    <span class="badge bg-success" id="nemotronStatusBadge">Stream Ready</span>
                </div>
                <div class="card-body p-3">
                    <!-- Customer Acoustic Telemetry Status -->
                    <div class="p-2 mb-3 rounded bg-light border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-muted">Acoustic Tone &amp; Latensi Bicara:</span>
                            <span class="badge bg-primary" id="customerToneBadge">Netral / Tenang</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between small text-muted">
                            <span>Turn-Taking Latency:</span>
                            <strong class="text-success" id="turnTakingLatencyText">120 ms (Target &lt; 180ms)</strong>
                        </div>
                        <div class="d-flex align-items-center justify-content-between small text-muted mt-1">
                            <span>Speech Prosody Cadence:</span>
                            <span id="speechProsodyText">Percakapan Normal • Stabil</span>
                        </div>
                    </div>

                    <!-- Dual Draft Suggestions (Qwen Reasoning vs Nemotron Spoken Script) -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-bold text-muted mb-0">Dual-Draft Copilot Suggestion:</label>
                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" id="btnRefreshDualDraft">
                                🔄 Refresh Draft
                            </button>
                        </div>

                        <!-- Tab Draft Selector -->
                        <ul class="nav nav-pills nav-fill mb-2" id="dualDraftTabs" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active py-1 small" id="qwen-draft-tab" data-bs-toggle="pill" data-bs-target="#qwen-draft" type="button">
                                    🧠 Qwen Reasoning
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link py-1 small" id="nemotron-draft-tab" data-bs-toggle="pill" data-bs-target="#nemotron-draft" type="button">
                                    🎙️ Nemotron Voice
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content border rounded p-2 bg-white" style="min-height: 90px; max-height: 180px; overflow-y: auto;">
                            <div class="tab-pane fade show active small" id="qwen-draft">
                                <p class="mb-0 text-muted" id="qwenDraftText">
                                    Halo Kak, pesanan Anda dengan nomor DO-20260917-8821 saat ini telah kami verifikasi dan berada dalam tahap pengiriman kurir ekspedisi. Ada informasi spesifik yang ingin kami bantu cek lebih lanjut?
                                </p>
                            </div>
                            <div class="tab-pane fade small" id="nemotron-draft">
                                <p class="mb-0 text-muted" id="nemotronDraftText">
                                    Halo Kak! Pesanan Anda saat ini sudah kami verifikasi dan sedang dalam perjalanan kurir ekspedisi. Ada hal lain yang bisa kami bantu jelaskan?
                                </p>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary flex-fill" id="btnApplyQwenDraft">
                                📋 Gunakan Draft Qwen
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success flex-fill" id="btnApplyNemotronDraft">
                                🗣️ Gunakan Naskah Nemotron
                            </button>
                            <button type="button" class="btn btn-sm btn-success w-100 mt-1 d-flex align-items-center justify-content-center gap-1" id="btnSendVoiceNote">
                                <span>🎙️ Kirim sebagai Voice Note (Nemotron TTS)</span>
                            </button>
                        </div>
                    </div>

                    <!-- Voice Dictation for Agent -->
                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-1" id="btnAgentDictation">
                            <span>🎤 Dikte Suara Agen (Nemotron ASR)</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Nemotron Strategic Long-Horizon (2026-2036) Live Voice Intelligence Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header py-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning text-dark fw-bold">2026–2036 Horizon</span>
                        <h6 class="mb-0 fw-bold">Nemotron Strategic Voice Agent</h6>
                    </div>
                    <span class="badge bg-info text-dark" id="horizonBadge">Live AI Voice</span>
                </div>
                <div class="card-body p-3">
                    <p class="text-muted small mb-2">
                        Prediksi live real-time kebutuhan masa depan 5–10 tahun ke depan berbasis <strong>NVIDIA Nemotron</strong>, Synthetic Data ODE $x(t)=[G,O,W,Q]$, dan konteks IKN &amp; Nusantara.
                    </p>

                    <!-- Dataset Fine-Tuning Status & Train Button -->
                    <div class="p-2 mb-3 rounded bg-white border shadow-sm d-flex justify-content-between align-items-center">
                        <div style="font-size: 0.74rem;">
                            <span class="d-block fw-bold text-success">🧠 Kalibrasi Model Dataset Terimpor:</span>
                            <span class="text-muted" id="modelTrainingStatusText">Siap dilatih dari 10.000+ UMKM &amp; 100+ instruksi riset</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-success py-1 px-2 rounded-pill fw-semibold" id="btnTrainFromDataset" style="font-size: 0.72rem;">
                            ⚡ Latih dari Dataset
                        </button>
                    </div>

                    <!-- Selector Controls -->
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted mb-0">Sektor:</label>
                            <select id="forecastSectorSelect" class="form-select form-select-sm">
                                <option value="Retail" selected>Retail &amp; E-Commerce</option>
                                <option value="Agri">Pertanian &amp; Pangan</option>
                                <option value="Logistics">Logistik &amp; Transport</option>
                                <option value="Tech">Teknologi &amp; AI</option>
                                <option value="F&B">F&amp;B Nusantara</option>
                                <option value="Energy">Energi &amp; Komoditas</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted mb-0">Horizon (Mulai 2026):</label>
                            <select id="forecastHorizonSelect" class="form-select form-select-sm">
                                <option value="5" selected>5 Tahun (2026–2031)</option>
                                <option value="10">10 Tahun (2026–2036)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted mb-0">Bahasa Suara:</label>
                            <select id="forecastLangSelect" class="form-select form-select-sm">
                                <option value="id" selected>Bahasa Indonesia</option>
                                <option value="jv">Basa Jawa</option>
                                <option value="su">Basa Sunda</option>
                                <option value="min">Baso Minangkabau</option>
                                <option value="mad">Basa Madhurâ</option>
                                <option value="ban">Basa Bali</option>
                                <option value="bug">Basa Bugis</option>
                                <option value="bjn">Bahasa Banjar (IKN Corridor)</option>
                                <option value="btk">Bahasa / Hata Batak</option>
                                <option value="en">English (Global)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted mb-0">Kawasan Indonesia:</label>
                            <select id="forecastRegionSelect" class="form-select form-select-sm">
                                <option value="Nasional" selected>Nasional RI</option>
                                <option value="IKN_Kalimantan">IKN &amp; Kalimantan</option>
                                <option value="Jawa_Bali">Jawa &amp; Bali</option>
                                <option value="Sumatera">Sumatera</option>
                                <option value="Indonesia_Timur">Kawasan Timur</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-sm btn-primary flex-fill fw-bold" id="btnRunHorizonForecast">
                            ⚡ Analisis Prediksi 2026–2036
                        </button>
                    </div>

                    <!-- Forecast Output Container -->
                    <div id="horizonForecastResultBox" style="display:none;" class="p-2 rounded border bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-primary" id="forecastTitleBadge">Retail 2026–2031</span>
                            <span class="small text-muted" id="forecastLatencyText">⚡ 45ms</span>
                        </div>
                        
                        <!-- Spoken Script with Play Voice Button -->
                        <div class="p-2 rounded bg-white border mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="small text-primary">🎙️ Naskah Briefing Nemotron:</strong>
                                <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill" id="btnPlayForecastAudio">
                                    ▶️ Dengarkan Suara
                                </button>
                            </div>
                            <p class="small text-muted mb-0 fst-italic" id="forecastSpokenScriptText"></p>
                            <audio id="forecastAudioPlayer" style="display:none;"></audio>
                        </div>

                        <!-- Strategic Needs List -->
                        <div class="mb-2">
                            <strong class="small text-dark d-block mb-1">🎯 Kebutuhan Masa Depan (Strategic Needs):</strong>
                            <ul class="small text-muted ps-3 mb-0" id="forecastNeedsList"></ul>
                        </div>

                        <!-- Trajectory Mini Table -->
                        <div>
                            <strong class="small text-dark d-block mb-1">📈 Lintasan Proyeksi Tahunan:</strong>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered text-center small mb-0" style="font-size: 0.72rem;">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Tahun</th>
                                            <th>Kebutuhan</th>
                                            <th>AI Agent %</th>
                                            <th>Logistik Hijau %</th>
                                        </tr>
                                    </thead>
                                    <tbody id="forecastTrajectoryTableBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Economic Intelligence & Graph Model Copilot -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary">AI Copilot</span>
                        <h6 class="mb-0 fw-bold">Intelijen Ekonomi & Graph Model</h6>
                    </div>
                    <span class="badge bg-success">Live Graph</span>
                </div>
                <div class="card-body p-3">
                    <!-- Quick Macro Ribbon -->
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (Model.EconomicIndicators.Any())
                        {
                            foreach (var ind in Model.EconomicIndicators.Take(6))
                            {
                                <div class="badge bg-light text-dark border p-2 text-start" style="font-size: 0.75rem;">
                                    <div class="text-muted" style="font-size: 0.65rem;">@ind.Label</div>
                                    <div class="fw-bold">@ind.CurrentValue @ind.Unit</div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Target Selector & Parameters -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Target Entitas / Sektor</label>
                        <select id="copilotTargetSelect" class="form-select form-select-sm">
                            <option value="RETAIL_ECOMMERCE">Sektor Ritel & E-Commerce UMKM</option>
                            <option value="INFLATION_CPI">Indeks Inflasi IHK</option>
                            <option value="BRENT_OIL">Minyak Mentah Brent (Energi)</option>
                            <option value="CRUDE_PALM_OIL">Kelapa Sawit CPO</option>
                            <option value="RICE_PRICE">Pangan Pokok (Beras)</option>
                            <option value="LOGISTICS_TRANSPORT">Sektor Logistik & Transportasi</option>
                            <option value="SME_PROFIT_MARGIN">Margin Keuntungan UMKM</option>
                            <option value="USD_IDR">Kurs Rupiah (USD/IDR)</option>
                            <option value="BI_RATE">Suku Bunga BI-Rate</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted mb-1">Horizon Proyeksi</label>
                            <select id="copilotHorizonSelect" class="form-select form-select-sm">
                                <option value="1">1 Bulan</option>
                                <option value="3" selected>3 Bulan</option>
                                <option value="6">6 Bulan</option>
                                <option value="12">12 Bulan</option>
                            </select>
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <button type="button" id="btnExtractFeatures" class="btn btn-sm btn-primary w-100 fw-semibold">
                                <span>Tarik Features & Prediksi</span>
                            </button>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <button type="button" id="btnRunMultiAgent" class="btn btn-sm btn-outline-dark w-100 fw-semibold">
                            <span>Jalankan Multi-Agent Workflow</span>
                        </button>
                    </div>

                    <!-- Copilot Output Display -->
                    <div id="copilotOutputContainer" class="p-3 bg-light rounded border" style="max-height: 480px; overflow-y: auto;">
                        <div id="copilotEmptyState" class="text-center py-4 text-muted small">
                            <p class="mb-1">Pilih entitas dan klik <strong>Tarik Features & Prediksi</strong> untuk mengekstraksi graf, menjalankan model forecasting ML/DL, dan melihat XAI feature importance.</p>
                        </div>

                        <!-- Dynamic Content will be injected here -->
                        <div id="copilotResults" class="d-none">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold mb-0 text-primary" id="resTargetName">-</h6>
                                <span class="badge" id="resTrendBadge">Neutral</span>
                            </div>

                            <div class="p-2 mb-3 bg-white rounded border">
                                <div class="d-flex justify-content-between small">
                                    <span class="text-muted">Nilai Baseline:</span>
                                    <strong id="resBaseVal">-</strong>
                                </div>
                                <div class="d-flex justify-content-between small">
                                    <span class="text-muted">Proyeksi Horizon:</span>
                                    <strong id="resFinalPred" class="text-primary">-</strong>
                                </div>
                                <div class="d-flex justify-content-between small">
                                    <span class="text-muted">Ekspektasi Perubahan:</span>
                                    <strong id="resPctChange">-</strong>
                                </div>
                                <div class="d-flex justify-content-between small">
                                    <span class="text-muted">Rentang Keyakinan 95%:</span>
                                    <span id="resConfidenceBand" class="text-muted small">-</span>
                                </div>
                            </div>

                            <!-- Graph Key Drivers -->
                            <div class="mb-3">
                                <div class="small fw-bold text-dark mb-1">Pendorong Utama Graf (XAI Feature Attribution)</div>
                                <div id="resDriversList" class="small">
                                    <!-- Drivers list -->
                                </div>
                            </div>

                            <!-- Strategic Insights -->
                            <div class="mb-3">
                                <div class="small fw-bold text-dark mb-1">Rekomendasi Strategis AI</div>
                                <ul id="resInsightsList" class="small ps-3 mb-0 text-secondary">
                                    <!-- Insights -->
                                </ul>
                            </div>

                            <!-- Action: Insert into chat message input -->
                            <button type="button" id="btnInsertReportToChat" class="btn btn-sm btn-success w-100 fw-semibold">
                                <span>Sisipkan Ringkasan ke Pesan Chat</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    <script>
        // Init agent session
        if (typeof currentSessionId !== 'undefined' && '@(Model.CurrentSession?.Id)') {
            currentSessionId = '@(Model.CurrentSession?.Id)';
        }

        // Scroll chat to bottom
        var chatBox = document.getElementById("chatMessages");
        if (chatBox) {
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function acceptEscalation(sessionId) {
            if (chatConnection.state === signalR.HubConnectionState.Connected) {
                chatConnection.invoke("AcceptEscalation", sessionId).then(function() {
                    // Reload page to reflect active status
                    window.location.href = "?ActiveSessionId=" + sessionId;
                }).catch(function (err) {
                    return console.error(err.toString());
                });
            } else {
                alert("Koneksi chat terputus. Menyambungkan kembali...");
            }
        }

        function endSession(sessionId) {
            if (confirm("Apakah Anda yakin ingin mengakhiri sesi chat ini?")) {
                chatConnection.invoke("EndSession", sessionId).then(function() {
                    window.location.href = "/Agent/LiveChat";
                }).catch(function (err) {
                    return console.error(err.toString());
                });
            }
        }

        // Agent-specific SignalR listeners
        chatConnection.on("SessionEscalated", function (sessionId, userId) {
            // Optional: Show toast or update badge
            var list = document.getElementById("escalatedSessionsList");
            if (list) {
                var noQueue = list.querySelector('.text-muted');
                if (noQueue) noQueue.remove();

                var html = `
                <a href="?ActiveSessionId=${sessionId}" class="list-group-item list-group-item-action py-3 bg-light">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1 fw-bold text-primary">Sesi Baru Masuk</h6>
                        <span class="badge bg-danger rounded-pill">New</span>
                    </div>
                    <p class="mb-1 small text-truncate">Menunggu bantuan agen...</p>
                </a>
                `;
                list.insertAdjacentHTML('afterbegin', html);
            }
        });

        // Economic Copilot State
        var lastEconReport = null;

        document.getElementById("btnExtractFeatures")?.addEventListener("click", async function() {
            var targetId = document.getElementById("copilotTargetSelect").value;
            var horizon = parseInt(document.getElementById("copilotHorizonSelect").value);
            var btn = this;
            btn.disabled = true;
            btn.innerText = "Memproses ML & Graf...";

            try {
                // 1. Forecast & Features Call
                var resForecast = await fetch("/api/v1/economic/forecast", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ targetEntityId: targetId, forecastHorizonMonths: horizon })
                });
                var dataForecast = await resForecast.json();

                // 2. XAI Attributions Call
                var resXai = await fetch(`/api/v1/economic/explain?targetEntityId=${encodeURIComponent(targetId)}&horizonMonths=${horizon}`, {
                    method: "POST"
                });
                var dataXai = await resXai.json();

                if (dataForecast.success && dataForecast.data) {
                    var f = dataForecast.data;
                    var x = dataXai.data || { featureAttributions: [], strategicInsights: [] };
                    lastEconReport = { forecast: f, xai: x };

                    document.getElementById("copilotEmptyState").classList.add("d-none");
                    document.getElementById("copilotResults").classList.remove("d-none");

                    document.getElementById("resTargetName").innerText = f.targetEntityName;
                    
                    var badge = document.getElementById("resTrendBadge");
                    badge.innerText = f.overallTrend;
                    badge.className = "badge " + (f.overallTrend.includes("Bullish") ? "bg-success" : (f.overallTrend.includes("Bearish") ? "bg-danger" : "bg-secondary"));

                    document.getElementById("resBaseVal").innerText = `${f.baselineValue} ${f.unit}`;
                    var lastPred = f.predictions[f.predictions.length - 1];
                    document.getElementById("resFinalPred").innerText = `${lastPred.predictedValue} ${f.unit}`;
                    document.getElementById("resPctChange").innerText = `${f.expectedPercentageChange > 0 ? '+' : ''}${f.expectedPercentageChange}%`;
                    document.getElementById("resConfidenceBand").innerText = `[${lastPred.confidenceLower95} - ${lastPred.confidenceUpper95}]`;

                    // Render drivers
                    var driversHtml = "";
                    if (x.featureAttributions && x.featureAttributions.length > 0) {
                        x.featureAttributions.slice(0, 4).forEach(function(d) {
                            var pct = Math.round(d.importanceScore * 100);
                            driversHtml += `
                                <div class="mb-1">
                                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.72rem;">
                                        <span>${escapeHtml(d.featureName)}</span>
                                        <span>${pct}%</span>
                                    </div>
                                    <div class="progress" style="height: 4px;">
                                        <div class="progress-bar ${d.directionalImpact > 0 ? 'bg-primary' : 'bg-warning'}" style="width: ${pct}%;"></div>
                                    </div>
                                </div>
                            `;
                        });
                    }
                    document.getElementById("resDriversList").innerHTML = driversHtml || "<span class='text-muted'>Tidak ada driver khusus.</span>";

                    // Render insights
                    var insightsHtml = "";
                    if (x.strategicInsights && x.strategicInsights.length > 0) {
                        x.strategicInsights.slice(0, 3).forEach(function(s) {
                            insightsHtml += `<li>${escapeHtml(s)}</li>`;
                        });
                    }
                    document.getElementById("resInsightsList").innerHTML = insightsHtml;
                }
            } catch (err) {
                console.error("Gagal memuat forecast:", err);
                alert("Gagal memuat proyeksi ekonomi.");
            } finally {
                btn.disabled = false;
                btn.innerText = "Tarik Features & Prediksi";
            }
        });

        document.getElementById("btnRunMultiAgent")?.addEventListener("click", async function() {
            var targetId = document.getElementById("copilotTargetSelect").value;
            var horizon = parseInt(document.getElementById("copilotHorizonSelect").value);
            var btn = this;
            btn.disabled = true;
            btn.innerText = "Multi-Agent Berjalan...";

            try {
                var res = await fetch("/api/v1/economic/agent/analyze", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        query: "Analisis prospek dan transmisi rantai pasok",
                        targetSectorOrCommodity: targetId,
                        horizonMonths: horizon,
                        requiresHumanSignoff: true
                    })
                });
                var data = await res.json();
                if (data.success && data.data) {
                    var rep = data.data;
                    lastEconReport = { forecast: rep.forecast, xai: rep.explanation, executiveSummary: rep.executiveSummary };

                    document.getElementById("copilotEmptyState").classList.add("d-none");
                    document.getElementById("copilotResults").classList.remove("d-none");

                    document.getElementById("resTargetName").innerText = rep.forecast.targetEntityName;
                    var badge = document.getElementById("resTrendBadge");
                    badge.innerText = rep.forecast.overallTrend;
                    badge.className = "badge " + (rep.forecast.overallTrend.includes("Bullish") ? "bg-success" : (rep.forecast.overallTrend.includes("Bearish") ? "bg-danger" : "bg-secondary"));

                    document.getElementById("resBaseVal").innerText = `${rep.forecast.baselineValue} ${rep.forecast.unit}`;
                    var lastPred = rep.forecast.predictions[rep.forecast.predictions.length - 1];
                    document.getElementById("resFinalPred").innerText = `${lastPred.predictedValue} ${rep.forecast.unit}`;
                    document.getElementById("resPctChange").innerText = `${rep.forecast.expectedPercentageChange > 0 ? '+' : ''}${rep.forecast.expectedPercentageChange}%`;
                    document.getElementById("resConfidenceBand").innerText = `[${lastPred.confidenceLower95} - ${lastPred.confidenceUpper95}]`;

                    // Insights
                    var insightsHtml = `<li><strong>Ringkasan Sistem Multi-Agent:</strong> ${escapeHtml(rep.executiveSummary)}</li>`;
                    if (rep.recommendedActions && rep.recommendedActions.length > 0) {
                        rep.recommendedActions.slice(0, 2).forEach(function(s) {
                            insightsHtml += `<li>${escapeHtml(s)}</li>`;
                        });
                    }
                    document.getElementById("resInsightsList").innerHTML = insightsHtml;
                }
            } catch (err) {
                console.error("Gagal menjalankan multi-agent:", err);
            } finally {
                btn.disabled = false;
                btn.innerText = "Jalankan Multi-Agent Workflow";
            }
        });

        // Insert report to chat message input
        document.getElementById("btnInsertReportToChat")?.addEventListener("click", function() {
            if (!lastEconReport) return;
            var f = lastEconReport.forecast;
            var x = lastEconReport.xai;
            var text = `📊 [Rekomendasi Intelijen Ekonomi DagangOnline]\nBerdasarkan model analitik graf dan ML kami untuk ${f.targetEntityName}:\n• Proyeksi Tren: ${f.overallTrend} (${f.expectedPercentageChange > 0 ? '+' : ''}${f.expectedPercentageChange}%)\n• Nilai Baseline: ${f.baselineValue} ${f.unit} ➔ Proyeksi: ${f.predictions[f.predictions.length-1].predictedValue} ${f.unit}\n• Saran Strategis: ${x.strategicInsights && x.strategicInsights.length > 0 ? x.strategicInsights[0] : 'Pantau stabilitas pasar.'}`;
            
            var chatInput = document.getElementById("chatMessageInput");
            if (chatInput) {
                chatInput.value = text;
                chatInput.focus();
            }
        });

        // Listen for real-time economic insights from hub
        chatConnection.on("ReceiveEconomicInsight", function(sessionId, report) {
            console.log("Menerima Economic Insight dari server:", report);
        });

        // ==========================================
        // Nemotron Voice & Acoustic Copilot Handlers
        // ==========================================
        var currentSessionId = "@(Model.ActiveSessionId?.ToString() ?? "")";
        var isDictating = false;

        document.getElementById("btnApplyQwenDraft")?.addEventListener("click", function() {
            var text = document.getElementById("qwenDraftText")?.innerText.trim();
            if (text) {
                var input = document.getElementById("chatMessageInput");
                if (input) {
                    input.value = text;
                    input.focus();
                }
            }
        });

        document.getElementById("btnApplyNemotronDraft")?.addEventListener("click", function() {
            var text = document.getElementById("nemotronDraftText")?.innerText.trim();
            if (text) {
                var input = document.getElementById("chatMessageInput");
                if (input) {
                    input.value = text;
                    input.focus();
                }
            }
        });

        document.getElementById("btnSendVoiceNote")?.addEventListener("click", async function() {
            if (!currentSessionId) {
                alert("Pilih sesi percakapan terlebih dahulu.");
                return;
            }

            var spokenText = document.getElementById("nemotronDraftText")?.innerText.trim();
            var inputVal = document.getElementById("chatMessageInput")?.value.trim();
            var textToSend = inputVal || spokenText || "Terima kasih telah menghubungi Customer Service dagangOnline.";

            var btn = this;
            btn.disabled = true;
            btn.innerHTML = "<span>Membuat Audio Nemotron...</span>";

            try {
                var res = await fetch("/api/v1/voice/synthesize", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        text: textToSend,
                        targetLanguage: "id",
                        returnAudioStream: true
                    })
                });

                var json = await res.json();
                if (json.success && json.data) {
                    // Send voice note via SignalR hub
                    await chatConnection.invoke("SendSpokenVoiceNote", currentSessionId, textToSend, "id");
                    if (document.getElementById("chatMessageInput")) {
                        document.getElementById("chatMessageInput").value = "";
                    }
                }
            } catch (err) {
                console.error("Gagal mengirim Voice Note:", err);
                alert("Gagal mensintesis voice note Nemotron.");
            } finally {
                btn.disabled = false;
                btn.innerHTML = "<span>🎙️ Kirim sebagai Voice Note (Nemotron TTS)</span>";
            }
        });

        document.getElementById("btnAgentDictation")?.addEventListener("click", async function() {
            var btn = this;
            if (!isDictating) {
                isDictating = true;
                btn.classList.remove("btn-outline-secondary");
                btn.classList.add("btn-danger");
                btn.innerHTML = "<span class='spinner-grow spinner-grow-sm me-1'></span><span>Mendengarkan Dikte Suara...</span>";

                // Simulated dictation stream after short delay
                setTimeout(function() {
                    var input = document.getElementById("chatMessageInput");
                    if (input && isDictating) {
                        input.value = (input.value ? input.value + " " : "") + "Halo Kak, status resi pesanan sudah dicek dan dalam perjalanan kurir hari ini.";
                    }
                    isDictating = false;
                    btn.classList.remove("btn-danger");
                    btn.classList.add("btn-outline-secondary");
                    btn.innerHTML = "<span>🎤 Dikte Suara Agen (Nemotron ASR)</span>";
                }, 1800);
            } else {
                isDictating = false;
                btn.classList.remove("btn-danger");
                btn.classList.add("btn-outline-secondary");
                btn.innerHTML = "<span>🎤 Dikte Suara Agen (Nemotron ASR)</span>";
            }
        });

        document.getElementById("btnRefreshDualDraft")?.addEventListener("click", async function() {
            var btn = this;
            btn.disabled = true;
            btn.innerText = "⏳ Loading...";

            try {
                var res = await fetch("/api/v1/voice/chat", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        sessionId: currentSessionId || null,
                        textPrompt: "Pelanggan menanyakan panduan status pesanan dan metode pembayaran",
                        returnAudio: true
                    })
                });

                var json = await res.json();
                if (json.success && json.data) {
                    var data = json.data;
                    document.getElementById("qwenDraftText").innerText = data.groundedTextResponse || "Draft Qwen diperbarui.";
                    document.getElementById("nemotronDraftText").innerText = data.spokenResponse || data.groundedTextResponse;

                    if (data.acousticTelemetry) {
                        document.getElementById("customerToneBadge").innerText = data.acousticTelemetry.emotionTone;
                        document.getElementById("turnTakingLatencyText").innerText = data.acousticTelemetry.turnTakingLatencyMs + " ms (Target < 180ms)";
                    }
                }
            } catch (err) {
                console.error("Gagal refresh draft:", err);
            } finally {
                btn.disabled = false;
                btn.innerText = "🔄 Refresh Draft";
            }
        });

        // Real-time SignalR Telemetry from Customer Voice
        chatConnection.on("ReceiveAcousticTelemetry", function(sessionId, telemetry) {
            if (telemetry) {
                var toneBadge = document.getElementById("customerToneBadge");
                if (toneBadge) {
                    toneBadge.innerText = telemetry.emotionTone;
                    if (telemetry.emotionTone.includes("Cemas") || telemetry.emotionTone.includes("Marah")) {
                        toneBadge.className = "badge bg-danger";
                    } else if (telemetry.emotionTone.includes("Gembira") || telemetry.emotionTone.includes("Bersahabat")) {
                        toneBadge.className = "badge bg-success";
                    } else {
                        toneBadge.className = "badge bg-primary";
                    }
                }

                var latEl = document.getElementById("turnTakingLatencyText");
                if (latEl) {
                    latEl.innerText = telemetry.turnTakingLatencyMs + " ms (Target < 180ms)";
                }

                var prosodyEl = document.getElementById("speechProsodyText");
                if (prosodyEl) {
                    prosodyEl.innerText = `Tempo: ${telemetry.speechRateWpm} WPM • Pitch Var: ${telemetry.pitchVariability.toFixed(2)}`;
                }
            }
        });

        // Real-time Collaborative Voice Turn update
        chatConnection.on("ReceiveCollaborativeVoice", function(sessionId, collabResult) {
            if (collabResult) {
                if (document.getElementById("qwenDraftText")) {
                    document.getElementById("qwenDraftText").innerText = collabResult.groundedTextResponse;
                }
                if (document.getElementById("nemotronDraftText")) {
                    document.getElementById("nemotronDraftText").innerText = collabResult.spokenResponse || collabResult.groundedTextResponse;
                }
            }
        });

        // Real-time Voice Note received
        chatConnection.on("ReceiveVoiceNote", function(sessionId, audioBase64, spokenScript, senderType) {
            console.log(`Voice note diterima (${senderType}):`, spokenScript);
        });

        // Barge-in interruption event
        chatConnection.on("BargeInInterruption", function(sessionId) {
            console.log("Barge-in terdeteksi pada sesi:", sessionId);
        });

        // Nemotron Strategic 2026-2036 Long-Horizon Forecast Handler
        var currentForecastAudioBase64 = null;

        function renderForecastResult(forecast) {
            if (!forecast) return;
            var box = document.getElementById("horizonForecastResultBox");
            if (box) box.style.display = "block";

            var badge = document.getElementById("forecastTitleBadge");
            if (badge) badge.innerText = `${forecast.sector} ${forecast.startYear}–${forecast.endYear} (${forecast.language.toUpperCase()})`;

            var lat = document.getElementById("forecastLatencyText");
            if (lat && forecast.telemetry) lat.innerText = `⚡ ${Math.round(forecast.telemetry.latencyMs)}ms`;

            var scriptEl = document.getElementById("forecastSpokenScriptText");
            if (scriptEl) scriptEl.innerText = `"${forecast.spokenVoiceScript}"`;

            currentForecastAudioBase64 = forecast.voiceAudioBase64;
            var player = document.getElementById("forecastAudioPlayer");
            if (player && currentForecastAudioBase64) {
                player.src = "data:audio/wav;base64," + currentForecastAudioBase64;
            }

            // Needs list
            var needsUl = document.getElementById("forecastNeedsList");
            if (needsUl) {
                needsUl.innerHTML = "";
                if (forecast.strategicNeedsIdentified) {
                    forecast.strategicNeedsIdentified.forEach(function(need) {
                        var li = document.createElement("li");
                        li.innerText = need;
                        needsUl.appendChild(li);
                    });
                }
            }

            // Trajectory table
            var tbody = document.getElementById("forecastTrajectoryTableBody");
            if (tbody) {
                tbody.innerHTML = "";
                if (forecast.trajectory) {
                    forecast.trajectory.forEach(function(pt) {
                        var tr = document.createElement("tr");
                        tr.innerHTML = `
                            <td><strong>${pt.year}</strong></td>
                            <td><span class="badge bg-light text-dark border">${pt.marketNeedIndex}</span></td>
                            <td><span class="badge bg-success bg-opacity-75">${pt.techAdoptionRate}%</span></td>
                            <td><span class="badge bg-info text-dark bg-opacity-75">${pt.greenLogisticsShare}%</span></td>
                        `;
                        tbody.appendChild(tr);
                    });
                }
            }
        }

        document.getElementById("btnTrainFromDataset")?.addEventListener("click", async function() {
            var btn = this;
            btn.disabled = true;
            btn.innerHTML = "<span class='spinner-border spinner-border-sm me-1'></span><span>Melatih Model...</span>";
            try {
                var res = await fetch("/api/v1/voice/train-from-dataset", { method: "POST" });
                var json = await res.json();
                if (json.success && json.data) {
                    var rep = json.data;
                    var statusEl = document.getElementById("modelTrainingStatusText");
                    if (statusEl) {
                        statusEl.innerText = `Aktif: ${rep.totalRecordsAbsorbed.toLocaleString()} records (${rep.umkmProfilesLearned.toLocaleString()} UMKM, ${rep.researchInstructionsLearned} riset ODE)`;
                    }
                    alert(`Pelatihan Selesai!\n${rep.summaryMessage}`);
                } else {
                    alert(json.message || "Gagal melatih model dari dataset.");
                }
            } catch (err) {
                console.error("Gagal melatih model:", err);
                alert("Terjadi kesalahan saat melatih model dari dataset.");
            } finally {
                btn.disabled = false;
                btn.innerHTML = "⚡ Latih dari Dataset";
            }
        });

        document.getElementById("btnRunHorizonForecast")?.addEventListener("click", async function() {
            var btn = this;
            var sector = document.getElementById("forecastSectorSelect")?.value || "Retail";
            var horizon = parseInt(document.getElementById("forecastHorizonSelect")?.value || "5");
            var lang = document.getElementById("forecastLangSelect")?.value || "id";
            var region = document.getElementById("forecastRegionSelect")?.value || "Nasional";

            btn.disabled = true;
            btn.innerHTML = "<span class='spinner-border spinner-border-sm me-1'></span><span>Memproses Proyeksi Nemotron...</span>";

            try {
                var response = await fetch("/api/v1/voice/forecast/long-horizon", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        sector: sector,
                        horizonYears: horizon,
                        language: lang,
                        regionalFocus: region,
                        scenarioType: "Baseline",
                        returnVoiceAudio: true
                    })
                });

                var json = await response.json();
                if (json && json.success && json.data) {
                    renderForecastResult(json.data);
                    // Also invoke over SignalR if connected
                    if (chatConnection.state === signalR.HubConnectionState.Connected && currentSessionId) {
                        chatConnection.invoke("RequestLongHorizonForecast", currentSessionId, {
                            sector: sector,
                            horizonYears: horizon,
                            language: lang,
                            regionalFocus: region,
                            returnVoiceAudio: false
                        }).catch(function(e) { console.log("SignalR forecast notify:", e); });
                    }
                } else {
                    alert(json.message || "Gagal memproses prediksi masa depan.");
                }
            } catch (err) {
                console.error("Horizon forecast error:", err);
                alert("Terjadi kesalahan memproses prediksi 5-10 tahun.");
            } finally {
                btn.disabled = false;
                btn.innerHTML = "⚡ Analisis Prediksi 2026–2036";
            }
        });

        document.getElementById("btnPlayForecastAudio")?.addEventListener("click", function() {
            var script = document.getElementById("forecastSpokenScriptText")?.innerText.replace(/^"|"$/g, "").trim();
            var lang = document.getElementById("forecastLangSelect")?.value || "id";
            if (script || currentForecastAudioBase64) {
                if (window.playNemotronVoice) {
                    window.playNemotronVoice(currentForecastAudioBase64, script, lang);
                } else {
                    var player = document.getElementById("forecastAudioPlayer");
                    if (player && player.src) {
                        player.play().catch(function(e) { console.warn("Audio play blocked:", e); });
                    }
                }
            } else {
                alert("Audio suara Nemotron belum tersedia.");
            }
        });

        chatConnection.on("ReceiveLongHorizonForecast", function(sessionId, forecast) {
            renderForecastResult(forecast);
        });
    </script>
}

