@page
@model dagangOnline.Pages.AboutModel
@{
    ViewData["Title"] = Model.AboutPage?.Title ?? "Tentang Kami - Sahabat UMKM";
}

<div class="container py-5">
    <div class="row align-items-center mb-5">
        <div class="col-lg-8 mx-auto text-center">
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-3">
                🤝 Sahabat Usaha & Warga Lokal
            </span>
            <h1 class="display-5 fw-bold mb-3">@(Model.AboutPage?.Title ?? "Tumbuh Bersama, Memajukan Usaha Lokal")</h1>
            <p class="lead text-muted">
                @(Model.AboutPage?.MetaDescription ?? "dagangOnline hadir sebagai teman setia bagi pelaku UMKM, pemilik warung, perintis usaha kecil, dan masyarakat luas untuk melangkah ke dunia jualan digital dengan cara yang mudah, bersahabat, dan saling mendukung.")
            </p>
        </div>
    </div>

    @if (Model.AboutPage != null && !string.IsNullOrWhiteSpace(Model.AboutPage.Content))
    {
        <div class="row justify-content-center mb-5">
            <div class="col-lg-9">
                <div class="card shadow-sm border-0 p-4 rounded-4">
                    <div class="card-body">
                        @Html.Raw(Model.AboutPage.Content)
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Visi & Misi Grid -->
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm p-4 bg-light rounded-4">
                    <div class="card-body">
                        <div class="text-primary mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-heart-fill" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314z"/>
                            </svg>
                        </div>
                        <h3 class="h4 fw-bold">Niat & Harapan Kami</h3>
                        <p class="text-muted">
                            Mewujudkan wadah gotong royong yang hangat dan terbuka bagi siapa saja, di mana pedagang kecil, pengrajin rumahan, dan wirausaha pemula dapat berkembang serta sejahtera bersama masyarakat sekitar.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm p-4 bg-light rounded-4">
                    <div class="card-body">
                        <div class="text-success mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16">
                                <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
                            </svg>
                        </div>
                        <h3 class="h4 fw-bold">Langkah Nyata Kami</h3>
                        <ul class="text-muted ps-3 mb-0">
                            <li class="mb-2">Menghadirkan sarana jualan yang gampang dipahami dan dipakai siapa saja tanpa bahasa teknis yang membingungkan.</li>
                            <li class="mb-2">Membuka jalan bagi produk-produk lokal agar lebih mudah ditemukan dan dibeli oleh tetangga serta warga luas.</li>
                            <li>Menemani dan mendampingi para perintis usaha kecil dengan penuh kesabaran dan kehangatan.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Core Values -->
        <div class="mb-5">
            <div class="text-center mb-4">
                <h2 class="h3 fw-bold">Nilai yang Kami Pegang Teguh</h2>
                <p class="text-muted">Prinsip sederhana yang menjadi landasan kami melayani Anda setiap hari</p>
            </div>
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="p-4 border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="mb-2 fs-2">🤝</div>
                        <h5 class="fw-bold">Gotong Royong</h5>
                        <p class="text-muted small">Mengutamakan semangat kekeluargaan dan saling bantu agar semua pelaku usaha bisa maju bersama.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="mb-2 fs-2">📱</div>
                        <h5 class="fw-bold">Praktis & Mudah</h5>
                        <p class="text-muted small">Tampilan simpel yang nyaman digunakan langsung dari ponsel, bahkan bagi yang baru pertama kali jualan online.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="mb-2 fs-2">🛡️</div>
                        <h5 class="fw-bold">Amanah & Terpercaya</h5>
                        <p class="text-muted small">Menjaga kepercayaan pedagang dan pembeli dengan pencatatan yang jujur, jelas, dan transparan.</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- CTA Section -->
    <div class="p-5 text-center bg-primary text-white rounded-4 shadow">
        <h2 class="fw-bold mb-3">Punya Usaha yang Ingin Dikembangkan?</h2>
        <p class="lead mb-4 col-lg-8 mx-auto">Yuk ngobrol santai bersama tim kami. Kami selalu senang mendengarkan cerita dan siap menemani langkah usaha Anda.</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-page="/Contact" class="btn btn-light btn-lg px-4 fw-semibold text-primary rounded-pill">Sapa Kami Sekarang</a>
            <a asp-page="/Services" class="btn btn-outline-light btn-lg px-4 rounded-pill">Lihat Bantuan Usaha</a>
        </div>
    </div>
</div>
