@page
@model dagangOnline.Pages.ContactModel
@{
    ViewData["Title"] = "Hubungi Kami";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Kontak & Konsultasi</span>
        <h1 class="display-5 fw-bold">Hubungi Tim Kami</h1>
        <p class="lead text-muted">Diskusikan kebutuhan proyek Anda atau tanyakan informasi seputar layanan dan kemitraan</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>Berhasil!</strong> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>Perhatian:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-5">
        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-4">
                <div class="card-body">
                    <h3 class="h4 fw-bold mb-4">Kirim Pesan / Inquiri</h3>
                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Input.Name" class="form-label fw-semibold">Nama Lengkap <span class="text-danger">*</span></label>
                            <input asp-for="Input.Name" class="form-control" placeholder="contoh: Budi Santoso" />
                            <div class="form-text small text-muted">Nama lengkap atau nama penanggung jawab organisasi.</div>
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold">Alamat Email <span class="text-danger">*</span></label>
                            <input asp-for="Input.Email" type="email" class="form-control" placeholder="contoh: budi@domain.com" />
                            <div class="form-text small text-muted">Kami akan mengirimkan balasan konsultasi ke email ini.</div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.Category" class="form-label fw-semibold">Kategori Inquiri</label>
                                <select asp-for="Input.Category" class="form-select">
                                    <option value="General">Pertanyaan Umum</option>
                                    <option value="Consultation">Konsultasi Layanan</option>
                                    <option value="Partnership">Kemitraan Mitra</option>
                                    <option value="Support">Bantuan Teknis</option>
                                </select>
                                <span asp-validation-for="Input.Category" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Subject" class="form-label fw-semibold">Subjek Pesan <span class="text-danger">*</span></label>
                                <input asp-for="Input.Subject" class="form-control" placeholder="contoh: Konsultasi Solusi Digital UMKM" />
                                <span asp-validation-for="Input.Subject" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Message" class="form-label fw-semibold">Pesan / Detail Kebutuhan <span class="text-danger">*</span></label>
                            <textarea asp-for="Input.Message" class="form-control" rows="5" placeholder="Jelaskan kebutuhan solusi, target waktu, atau pertanyaan yang ingin Anda diskusikan..."></textarea>
                            <div class="form-text small text-muted">Sertakan informasi bisnis yang relevan agar tim kami dapat merespons secara akurat.</div>
                            <span asp-validation-for="Input.Message" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Input.ConsentAccepted" class="form-check-input" type="checkbox" id="consentCheck" />
                            <label class="form-check-label small text-muted" for="consentCheck">
                                Saya menyetujui data yang dikirimkan diproses untuk keperluan tindak lanjut komunikasi sesuai kebijakan privasi. <span class="text-danger">*</span>
                            </label>
                            <div>
                                <span asp-validation-for="Input.ConsentAccepted" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                            Kirim Pesan
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Contact Information Sidebar -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-4 bg-light mb-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Informasi Kontak</h4>
                    <p class="text-muted small mb-4">
                        Kami siap membantu bisnis Anda berkembang lebih cepat melalui integrasi teknologi yang tepat.
                    </p>

                    <div class="d-flex mb-3">
                        <div class="me-3 text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-geo-alt" viewBox="0 0 16 16">
                                <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A31.493 31.493 0 0 1 8 14.58a31.481 31.481 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94zM8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10z"/>
                                <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                            </svg>
                        </div>
                        <div>
                            <strong class="d-block">Alamat Kantor</strong>
                            <span class="text-muted small">Jl. Teknologi Digital No. 42, Jakarta Selatan, Indonesia</span>
                        </div>
                    </div>

                    <div class="d-flex mb-3">
                        <div class="me-3 text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
                                <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                            </svg>
                        </div>
                        <div>
                            <strong class="d-block">Email Resmi</strong>
                            <span class="text-muted small">info@dagangonline.local</span>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="me-3 text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-clock" viewBox="0 0 16 16">
                                <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                            </svg>
                        </div>
                        <div>
                            <strong class="d-block">Jam Operasional</strong>
                            <span class="text-muted small">Senin - Jumat: 09:00 - 17:00 WIB</span>
                        </div>
                    </div>

                    <hr />

                    <h5 class="fw-semibold mb-2">Ingin Bergabung Sebagai Mitra?</h5>
                    <p class="text-muted small mb-3">
                        Dapatkan akses ke ekosistem proyek dan perluas jangkauan layanan bisnis Anda.
                    </p>
                    <a asp-page="/Account/Register" class="btn btn-outline-primary btn-sm">Daftar Mitra Sekarang</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
