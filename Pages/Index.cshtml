            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner" style="border: 1px solid var(--border);">
            <div class="carousel-item active" style="background-color: var(--surface-warm); min-height: 240px;">
                <div class="d-flex justify-content-center align-items-center h-100 p-5 text-center">
                    <div>
                        <span class="badge bg-danger mb-2 px-3 py-1 rounded-pill">HOT EVENT</span>
                        <h3 class="fw-bold text-dark">Webinar: Strategi Jualan Laris Manis 2026</h3>
                        <p class="text-muted mb-3">Ikuti sesi gratis bersama ahli digital marketing khusus untuk UMKM lokal.</p>
                        <a asp-page="/Services" class="btn btn-primary rounded-pill px-4">Daftar Sekarang</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item" style="background-color: var(--accent-subtle); min-height: 240px;">
                <div class="d-flex justify-content-center align-items-center h-100 p-5 text-center">
                    <div>
                        <span class="badge bg-primary-subtle text-primary mb-2 px-3 py-1 rounded-pill">PROMO MITRA</span>
                        <h3 class="fw-bold text-dark">Diskon Ongkir Seluruh Nusantara</h3>
                        <p class="text-muted mb-3">Nikmati potongan ongkir hingga 50% untuk setiap pengiriman minggu ini.</p>
                        <a asp-page="/Partnership" class="btn btn-primary rounded-pill px-4">Cek Syarat & Ketentuan</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item" style="background-color: var(--surface); min-height: 240px;">
                <div class="d-flex justify-content-center align-items-center h-100 p-5 text-center">
                    <div>
                        <span class="badge bg-primary-subtle text-primary mb-2 px-3 py-1 rounded-pill">FITUR BARU</span>
                        <h3 class="fw-bold text-dark">Fitur "Bincang Bisnis" Kini Tersedia</h3>
                        <p class="text-muted mb-3">Hubungi langsung mitra kami melalui WhatsApp & Email untuk kolaborasi.</p>
                        <a asp-page="/Contact" class="btn btn-outline-primary rounded-pill px-4">Pelajari Lebih Lanjut</a>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#eventCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: invert(1);"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#eventCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true" style="filter: invert(1);"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>

