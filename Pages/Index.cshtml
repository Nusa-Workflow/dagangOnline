@page
@model IndexModel
@{
    ViewData["Title"] = "Platform Solusi Digital & Ekosistem Bisnis";
}

<!-- Hero Section -->
<section class="py-5">
    <div class="hero-gradient p-5 shadow-lg position-relative overflow-hidden mb-5">
        <div class="row align-items-center py-4">
            <div class="col-lg-8">
                <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-semibold mb-3">Ekosistem Teknologi Dagang Online</span>
                <h1 class="display-4 fw-bold mb-3">Solusi Transformasi Digital Terintegrasi</h1>
                <p class="lead mb-4 text-white-50">
                    Akselerasi pertumbuhan bisnis dan UMKM melalui software engineering terpercaya, katalog produk terverifikasi, dan kemitraan digital handal.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-page="/Services" class="btn btn-light btn-lg px-4 fw-semibold text-primary shadow-sm">Jelajahi Layanan</a>
                    <a asp-page="/Contact" class="btn btn-outline-light btn-lg px-4 fw-semibold">Konsultasi Gratis</a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-end">
                <svg xmlns="http://www.w3.org/2000/svg" width="220" height="220" fill="currentColor" class="bi bi-clouds text-white opacity-25" viewBox="0 0 16 16">
                    <path d="M16 14a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3l1-2h4l1 2h3a2 2 0 0 1 2 2v9z"/>
                </svg>
            </div>
        </div>
    </div>
</section>

<!-- Stats / Trust Indicators -->
<section class="mb-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="stats-box shadow-sm">
                <h3 class="display-6 fw-bold text-primary mb-1">99.9%</h3>
                <p class="text-muted mb-0 fw-semibold">Platform Uptime & Reliabilitas</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stats-box shadow-sm">
                <h3 class="display-6 fw-bold text-success mb-1">Modern Stack</h3>
                <p class="text-muted mb-0 fw-semibold">Arsitektur .NET 10 & PostgreSQL</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stats-box shadow-sm">
                <h3 class="display-6 fw-bold text-info mb-1">Enterprise RBAC</h3>
                <p class="text-muted mb-0 fw-semibold">Keamanan Berlapis & Audit Trail</p>
            </div>
        </div>
    </div>
</section>

<!-- Featured Services Section -->
<section class="py-4 mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">Layanan Unggulan</h2>
            <p class="text-muted mb-0">Solusi digital komprehensif yang dirancang untuk skala bisnis Anda</p>
        </div>
        <a asp-page="/Services" class="btn btn-outline-primary btn-sm">Lihat Semua Layanan &rarr;</a>
    </div>

    @if (Model.FeaturedServices.Any())
    {
        <div class="row g-4">
            @foreach (var s in Model.FeaturedServices)
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm feature-card p-3">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-2">@s.Name</h5>
                            <p class="card-text text-muted flex-grow-1">@s.Summary</p>
                            <div class="mt-3">
                                <a asp-page="/Services" class="btn btn-sm btn-primary">Pelajari Layanan</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm feature-card p-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-2">Digitalisasi UMKM</h5>
                        <p class="text-muted">Membangun platform belanja digital, POS terintegrasi, dan manajemen inventori modern.</p>
                        <a asp-page="/Services" class="btn btn-sm btn-outline-primary">Detail Layanan</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm feature-card p-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-2">Custom Software Engineering</h5>
                        <p class="text-muted">Pengembangan sistem backend scalable, REST API, arsitektur microservice, dan integrasi payment gateway.</p>
                        <a asp-page="/Services" class="btn btn-sm btn-outline-primary">Detail Layanan</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm feature-card p-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-2">Platform Keamanan & Cloud</h5>
                        <p class="text-muted">Hardening server, audit log trail, perlindungan rate-limiting, dan manajemen akses RBAC.</p>
                        <a asp-page="/Services" class="btn btn-sm btn-outline-primary">Detail Layanan</a>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

<!-- Call to Action Banner -->
<section class="p-5 text-center bg-light rounded-3 border mb-5">
    <div class="container py-3">
        <h2 class="fw-bold mb-3">Kolaborasi Bersama Kami</h2>
        <p class="lead text-muted col-lg-8 mx-auto mb-4">
            Ingin mengembangkan sistem enterprise, membuka toko online modern, atau bermitra bersama platform dagangOnline? Hubungi tim kami sekarang.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-page="/Contact" class="btn btn-primary btn-lg px-4">Mulai Sekarang</a>
            <a asp-page="/About" class="btn btn-outline-secondary btn-lg px-4">Tentang Platform</a>
        </div>
    </div>
</section>
