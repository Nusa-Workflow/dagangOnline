@page
@model IndexModel
@{
    ViewData["Title"] = "Teman Jualan & Sahabat Tumbuh UMKM";
}

<!-- Hero Section -->
<section class="py-5">
    <div class="hero-gradient p-5 shadow-lg position-relative overflow-hidden mb-5 rounded-4">
        <div class="row align-items-center py-4">
            <div class="col-lg-8">
                <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-semibold mb-3">
                    🤝 Sahabat Usaha & Komunitas UMKM
                </span>
                <h1 class="display-4 fw-bold mb-3">Mudahnya Jualan Online & Kembangkan Usaha Bersama</h1>
                <p class="lead mb-4 text-white-50">
                    Wadah gotong royong digital yang ramah dan bersahabat untuk membantu warung, pelaku UMKM, dan perintis usaha kecil jualan lebih laris, mengelola toko lebih gampang, dan terhubung langsung dengan pelanggan.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-page="/Services" class="btn btn-light btn-lg px-4 fw-semibold text-primary shadow-sm">Lihat Bantuan Usaha</a>
                    <a asp-page="/Contact" class="btn btn-outline-light btn-lg px-4 fw-semibold">Tanya & Konsultasi Santai</a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-end">
                <svg xmlns="http://www.w3.org/2000/svg" width="220" height="220" fill="currentColor" class="bi bi-shop text-white opacity-25" viewBox="0 0 16 16">
                    <path d="M2.97 1.35A1 1 0 0 1 3.73 1h8.54a1 1 0 0 1 .76.35l2.609 3.044A1.5 1.5 0 0 1 16 5.37v.255a2.375 2.375 0 0 1-4.25 1.458A2.371 2.371 0 0 1 9.875 8 2.37 2.37 0 0 1 8 7.083 2.37 2.37 0 0 1 6.125 8a2.37 2.37 0 0 1-1.875-.917A2.375 2.375 0 0 1 0 5.625V5.37a1.5 1.5 0 0 1 .361-.976l2.61-3.045zm1.78 4.275a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 1 0 2.75 0V5.37a.5.5 0 0 0-.12-.325L12.27 2H3.73L1.12 5.045A.5.5 0 0 0 1 5.37v.255a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0zM1.5 8.5A.5.5 0 0 1 2 9v6h12V9a.5.5 0 0 1 1 0v6h1a.5.5 0 0 1 0 1H0a.5.5 0 0 1 0-1h1V9a.5.5 0 0 1 .5-.5zm2 .5a.5.5 0 0 1 .5.5V13h8V9.5a.5.5 0 0 1 1 0V13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5a.5.5 0 0 1 .5-.5z"/>
                </svg>
            </div>
        </div>
    </div>
</section>

<!-- Event Carousel Section -->
<section class="mb-5">
    <div id="eventCarousel" class="carousel slide carousel-fade shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active" style="background-color: #f8f9fa; min-height: 250px;">
                <div class="d-flex justify-content-center align-items-center h-100 p-5 text-center">
                    <div>
                        <span class="badge bg-danger mb-2">HOT EVENT</span>
                        <h3 class="fw-bold">Webinar: Strategi Jualan Laris Manis 2026</h3>
                        <p class="text-muted">Ikuti sesi gratis bersama ahli digital marketing khusus untuk UMKM lokal.</p>
                        <a href="#" class="btn btn-primary rounded-pill">Daftar Sekarang</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item" style="background-color: #e9ecef; min-height: 250px;">
                <div class="d-flex justify-content-center align-items-center h-100 p-5 text-center">
                    <div>
                        <span class="badge bg-success mb-2">PROMO MITRA</span>
                        <h3 class="fw-bold">Diskon Ongkir Seluruh Nusantara</h3>
                        <p class="text-muted">Nikmati potongan ongkir hingga 50% untuk setiap pengiriman minggu ini.</p>
                        <a href="#" class="btn btn-success rounded-pill">Cek Syarat & Ketentuan</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item" style="background-color: #e2e3e5; min-height: 250px;">
                <div class="d-flex justify-content-center align-items-center h-100 p-5 text-center">
                    <div>
                        <span class="badge bg-info text-dark mb-2">INFO BARU</span>
                        <h3 class="fw-bold">Fitur "Bincang Bisnis" Kini Tersedia</h3>
                        <p class="text-muted">Hubungi langsung mitra kami melalui WhatsApp & Email untuk kolaborasi.</p>
                        <a asp-page="/Services" class="btn btn-outline-dark rounded-pill">Pelajari Lebih Lanjut</a>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#eventCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: invert(1);"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#eventCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true" style="filter: invert(1);"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>

<!-- Stats / Trust Indicators -->
<section class="mb-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="stats-box shadow-sm p-4 rounded-4 bg-white border-0">
                <h3 class="display-6 fw-bold text-primary mb-1">100% Ramah</h3>
                <p class="text-muted mb-0 fw-semibold">Mudah Digunakan Tanpa Ribet Teknis</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stats-box shadow-sm p-4 rounded-4 bg-white border-0">
                <h3 class="display-6 fw-bold text-success mb-1">Gotong Royong</h3>
                <p class="text-muted mb-0 fw-semibold">Dukungan Nyata untuk Usaha Kecil & Pemula</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stats-box shadow-sm p-4 rounded-4 bg-white border-0">
                <h3 class="display-6 fw-bold text-info mb-1">Aman & Nyaman</h3>
                <p class="text-muted mb-0 fw-semibold">Pencatatan Jelas & Terpercaya</p>
            </div>
        </div>
    </div>
</section>

<!-- Featured Services Section -->
<section class="py-4 mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">Bantuan & Solusi Usaha</h2>
            <p class="text-muted mb-0">Langkah mudah untuk mendampingi perkembangan usaha Anda</p>
        </div>
        <a asp-page="/Services" class="btn btn-outline-primary btn-sm rounded-pill px-3">Lihat Semua Solusi &rarr;</a>
    </div>

    @if (Model.FeaturedServices.Any())
    {
        <div class="row g-4">
            @foreach (var s in Model.FeaturedServices)
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm feature-card p-3 rounded-4">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-2">@s.Name</h5>
                            <p class="card-text text-muted flex-grow-1">@s.Summary</p>
                            <div class="mt-3">
                                <a asp-page="/Services" class="btn btn-sm btn-primary rounded-pill px-3">Pelajari Selengkapnya</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm feature-card p-3 rounded-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-2">Bantu Warung & Toko Online</h5>
                        <p class="text-muted">Siapkan etalase jualan digital yang simpel, rapi, dan mudah dikelola langsung dari ponsel.</p>
                        <a asp-page="/Services" class="btn btn-sm btn-outline-primary rounded-pill px-3">Pelajari Bantuan</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm feature-card p-3 rounded-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-2">Pendampingan Usaha & Mitra</h5>
                        <p class="text-muted">Dampingi UMKM dan perintis usaha langkah demi langkah sampai percaya diri memasarkan produknya.</p>
                        <a asp-page="/Services" class="btn btn-sm btn-outline-primary rounded-pill px-3">Pelajari Bantuan</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm feature-card p-3 rounded-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-2">Pencatatan Rapi & Terpercaya</h5>
                        <p class="text-muted">Pembukuan jualan yang mudah dipahami tanpa istilah teknis rumit, bikin hati tenang saat berdagang.</p>
                        <a asp-page="/Services" class="btn btn-sm btn-outline-primary rounded-pill px-3">Pelajari Bantuan</a>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

<!-- Featured Portfolio Section -->
<section class="py-4 mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">Cerita Nyata Sahabat UMKM</h2>
            <p class="text-muted mb-0">Kisah sukses dan perjalanan tumbuh bersama teman-teman wirausaha lokal</p>
        </div>
        <a asp-page="/Portfolio" class="btn btn-outline-primary btn-sm rounded-pill px-3">Lihat Semua Cerita &rarr;</a>
    </div>

    @if (Model.FeaturedProjects.Any())
    {
        <div class="row g-4">
            @foreach (var p in Model.FeaturedProjects)
            {
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm feature-card p-4 rounded-4">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-dark mb-0">@p.Title</h5>
                                @if (p.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill">⭐ Pilihan</span>
                                }
                            </div>
                            <p class="card-text text-muted mb-3 flex-grow-1">@p.Summary</p>
                            @if (!string.IsNullOrWhiteSpace(p.Result))
                            {
                                <div class="p-2 bg-success bg-opacity-10 text-success rounded-3 small mb-3">
                                    <strong>Hasil Baik:</strong> @p.Result
                                </div>
                            }
                            <div>
                                <a asp-page="/Portfolio" class="btn btn-sm btn-outline-primary rounded-pill px-3">Baca Cerita Lengkap &rarr;</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm feature-card p-4 rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0">Warung Kelontong & Sembako Tetangga</h5>
                            <span class="badge bg-warning text-dark rounded-pill">⭐ Pilihan</span>
                        </div>
                        <p class="text-muted mb-3">Membantu warung kelontong warga mulai menerima pesanan warga sekitar dengan cepat dan mudah lewat ponsel.</p>
                        <div class="p-2 bg-success bg-opacity-10 text-success rounded-3 small mb-3">
                            <strong>Hasil Baik:</strong> Pesanan harian meningkat 2 kali lipat dan catatan belanja warga jadi lebih rapi.
                        </div>
                        <a asp-page="/Portfolio" class="btn btn-sm btn-outline-primary rounded-pill px-3">Baca Cerita Lengkap &rarr;</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm feature-card p-4 rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0">Kasir Sederhana Kedai Kopi Rumahan</h5>
                            <span class="badge bg-warning text-dark rounded-pill">⭐ Pilihan</span>
                        </div>
                        <p class="text-muted mb-3">Pencatatan kasir praktis untuk kedai kopi dan makanan ringan tanpa harus membeli peralatan mahal.</p>
                        <div class="p-2 bg-success bg-opacity-10 text-success rounded-3 small mb-3">
                            <strong>Hasil Baik:</strong> Waktu melayani pembeli lebih singkat dan persediaan bahan selalu terpantau aman.
                        </div>
                        <a asp-page="/Portfolio" class="btn btn-sm btn-outline-primary rounded-pill px-3">Baca Cerita Lengkap &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

<!-- Call to Action Banner -->
<section class="p-5 text-center bg-white rounded-4 border shadow-sm mb-5">
    <div class="container py-3">
        <h2 class="fw-bold mb-3">Mari Tumbuh dan Maju Bersama</h2>
        <p class="lead text-muted col-lg-8 mx-auto mb-4">
            Punya produk buatan sendiri, warung kelontong, kedai kopi, atau baru ingin mulai merintis usaha? Kami siap menemani setiap langkah perjalanan usaha Anda dengan ramah dan tulus.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-page="/Contact" class="btn btn-primary btn-lg px-4 rounded-pill fw-semibold">Mulai Bersama Kami</a>
            <a asp-page="/About" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">Mengenal Kami</a>
        </div>
    </div>
</section>
