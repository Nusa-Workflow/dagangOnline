@page
@model IndexModel
@{
    ViewData["Title"] = "Teman Jualan & Sahabat Tumbuh UMKM";
}

<!-- Palantir-Style Sovereign AI Video & Telemetry Hero Carousel -->
<section class="mb-5">
    <div class="palantir-hero-container position-relative" id="palantirHero">
        <!-- Canvas & Video High-Tech Topographic Background -->
        <div class="palantir-video-wrapper">
            <canvas id="palantirTopoCanvas" style="position: absolute; top:0; left:0; width:100%; height:100%; z-index:1;"></canvas>
            <video class="palantir-video d-none" id="palantirBgVideo" autoplay muted loop playsinline poster="https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=1200&auto=format&fit=crop">
                <source src="https://assets.mixkit.co/videos/preview/mixkit-topographic-map-contour-lines-animation-43093-large.mp4" type="video/mp4">
            </video>
        </div>

        <!-- High-Tech Matrix Grid & Scanline Overlays -->
        <div class="palantir-grid-overlay"></div>
        <div class="palantir-scanline"></div>

        <!-- Palantir Top HUD Header Bar -->
        <div class="palantir-hud-header">
            <a asp-page="/Index" class="palantir-logo-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 3v18"></path>
                    <path d="M3 12h18"></path>
                </svg>
                <span>PALANTIR <span style="color: #7A9E7E; font-size: 0.85rem; font-weight: 500;">/ DAGANGONLINE</span></span>
            </a>

            <div class="palantir-nav-right">
                <a asp-page="/Account/Register" class="palantir-btn-start">Get Started</a>
                <a asp-page="/Search" class="palantir-icon-btn" title="Search Intelligence & Catalog">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </a>
                <button class="palantir-icon-btn d-none d-sm-flex" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavDrawer" aria-label="Menu">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Carousel Slide Content Area -->
        <div class="palantir-content-body">
            <!-- Slide 1: Sovereign AI Decision Systems -->
            <div class="palantir-slide-item active" id="palantirSlide0">
                <div class="d-inline-flex align-items-center gap-2 px-2 py-1 mb-3 rounded-1 font-tech-mono" style="background: rgba(122, 158, 126, 0.15); border: 1px solid rgba(122, 158, 126, 0.35); color: #7A9E7E; font-size: 0.75rem;">
                    <span class="palantir-pulse-dot"></span>
                    <span>SOVEREIGN AI ENGINE • QWEN + GROQ RAG LAYER</span>
                </div>
                <h1 class="palantir-headline">Sovereign AI Systems<br class="d-none d-md-block" />for Every Decision</h1>
                <p class="palantir-subhead">
                    Infrastruktur kecerdasan artifisial terdesentralisasi untuk memandu rantai pasok pangan, intelijen penetapan harga pasar, dan akselerasi pertumbuhan mandiri bagi 65+ juta UMKM Indonesia.
                </p>
                <div class="palantir-cta-group">
                    <a asp-page="/Services" class="palantir-btn-start">Lihat Bantuan Usaha</a>
                    <a asp-page="/Contact" class="palantir-btn-ghost">Konsultasi Sistem AI</a>
                </div>
            </div>

            <!-- Slide 2: Decentralized Supply Chain Grid -->
            <div class="palantir-slide-item d-none" id="palantirSlide1">
                <div class="d-inline-flex align-items-center gap-2 px-2 py-1 mb-3 rounded-1 font-tech-mono" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #10B981; font-size: 0.75rem;">
                    <span class="palantir-pulse-dot"></span>
                    <span>LOGISTICS TELEMETRY & MULTI-TENANT ESCROW</span>
                </div>
                <h1 class="palantir-headline">Decentralized Logistics<br class="d-none d-md-block" />& Supply Chain Grid</h1>
                <p class="palantir-subhead">
                    Integrasi sensor rute pengiriman antarpulau, pelacakan armada kurir real-time, dan otomasi pesanan grosir B2B langsung dari sentra pengrajin nusantara tanpa perantara spekulatif.
                </p>
                <div class="palantir-cta-group">
                    <a asp-page="/Partnership" class="palantir-btn-start">Buka Kemitraan B2B</a>
                    <a asp-page="/Portfolio" class="palantir-btn-ghost">Pantau Jaringan Mitra</a>
                </div>
            </div>

            <!-- Slide 3: Autonomous Escrow & Economic Empowerment -->
            <div class="palantir-slide-item d-none" id="palantirSlide2">
                <div class="d-inline-flex align-items-center gap-2 px-2 py-1 mb-3 rounded-1 font-tech-mono" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); color: #F59E0B; font-size: 0.75rem;">
                    <span class="palantir-pulse-dot"></span>
                    <span>FINANCIAL SETTLEMENT & ZERO-COUNTERPARTY RISK</span>
                </div>
                <h1 class="palantir-headline">Autonomous Commerce<br class="d-none d-md-block" />with Total Security</h1>
                <p class="palantir-subhead">
                    Rekening bersama escrow terenkripsi dan integrasi gerbang pembayaran multi-kanal: QRIS dinamis, transfer instan 24/7, serta pencairan dana cepat 1x24 jam untuk para pelaku usaha kecil.
                </p>
                <div class="palantir-cta-group">
                    <a asp-page="/Account/Register" class="palantir-btn-start">Daftar Akun Toko</a>
                    <a asp-page="/Services" class="palantir-btn-ghost">Pelajari Ekosistem</a>
                </div>
            </div>
        </div>

        <!-- Palantir Bottom HUD Telemetry Bar & Carousel Pills -->
        <div class="palantir-hud-footer">
            <div class="d-flex align-items-center gap-4 flex-wrap">
                <div class="palantir-telemetry-item">
                    <span class="palantir-pulse-dot"></span>
                    <span>SYSTEM: OPERATIONAL</span>
                </div>
                <div class="palantir-telemetry-item d-none d-md-inline-flex">
                    <span>GRID: LAT -6.2088 / LON 106.8456 [ID-JKT]</span>
                </div>
                <div class="palantir-telemetry-item d-none d-lg-inline-flex">
                    <span>ACTIVE NODES: 2,840</span>
                </div>
            </div>

            <!-- Carousel Slide Controllers -->
            <div class="palantir-carousel-pills" id="palantirPillControls">
                <div class="palantir-pill-indicator active" onclick="switchPalantirSlide(0)" title="Slide 1: Sovereign AI"></div>
                <div class="palantir-pill-indicator" onclick="switchPalantirSlide(1)" title="Slide 2: Supply Chain"></div>
                <div class="palantir-pill-indicator" onclick="switchPalantirSlide(2)" title="Slide 3: Autonomous Commerce"></div>
            </div>
        </div>
    </div>
</section>

<!-- Event Carousel Section -->
<section class="mb-5">
