@section Scripts {
<script>
    // Palantir Video Carousel Slide Switcher
    let currentSlide = 0;
    const totalSlides = 3;
    let autoSlideInterval = null;

    function switchPalantirSlide(index) {
        for (let i = 0; i < totalSlides; i++) {
            const slideEl = document.getElementById('palantirSlide' + i);
            if (slideEl) {
                if (i === index) {
                    slideEl.classList.remove('d-none');
                    slideEl.classList.add('active');
                } else {
                    slideEl.classList.add('d-none');
                    slideEl.classList.remove('active');
                }
            }
        }

        const pills = document.querySelectorAll('#palantirPillControls .palantir-pill-indicator');
        pills.forEach((p, idx) => {
            if (idx === index) {
                p.classList.add('active');
            } else {
                p.classList.remove('active');
            }
        });

        currentSlide = index;
    }

    function startAutoSlide() {
        if (autoSlideInterval) clearInterval(autoSlideInterval);
        autoSlideInterval = setInterval(() => {
            const next = (currentSlide + 1) % totalSlides;
            switchPalantirSlide(next);
        }, 6500);
    }

    // Interactive Topographic Terrain & Radar Canvas (Palantir Visual Engine)
    (function initPalantirTopoEngine() {
        const canvas = document.getElementById('palantirTopoCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        let width, height;
        let time = 0;

        function resize() {
            width = canvas.width = canvas.parentElement.offsetWidth;
            height = canvas.height = canvas.parentElement.offsetHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        function render() {
            ctx.clearRect(0, 0, width, height);

            // 1. Dark ambient background gradient
            const bgGrad = ctx.createRadialGradient(width * 0.55, height * 0.45, 20, width * 0.5, height * 0.5, width * 0.7);
            bgGrad.addColorStop(0, '#0c1618');
            bgGrad.addColorStop(0.5, '#081014');
            bgGrad.addColorStop(1, '#05070a');
            ctx.fillStyle = bgGrad;
            ctx.fillRect(0, 0, width, height);

            // 2. Animated Topographic Contour Waves (Palantir amber & teal lines)
            const numLines = 14;
            for (let i = 0; i < numLines; i++) {
                ctx.beginPath();
                const yBase = (height / numLines) * i;
                const waveFreq = 0.003 + (i * 0.0003);
                const waveAmp = 35 + (i * 4);
                
                // Colors mimicking the yellow/orange terrain river in Palantir's interface
                if (i % 3 === 0) {
                    ctx.strokeStyle = `rgba(245, 158, 11, ${0.18 + Math.sin(time + i) * 0.08})`; // Amber / Gold
                    ctx.lineWidth = 1.8;
                } else if (i % 3 === 1) {
                    ctx.strokeStyle = `rgba(16, 185, 129, ${0.12 + Math.cos(time + i) * 0.05})`; // Teal / Sage
                    ctx.lineWidth = 1.2;
                } else {
                    ctx.strokeStyle = `rgba(59, 130, 246, 0.08)`; // Blue
                    ctx.lineWidth = 1;
                }

                for (let x = 0; x < width; x += 16) {
                    const noise = Math.sin(x * waveFreq + time + (i * 0.6)) * Math.cos(x * 0.0015 - time * 0.4);
                    const y = yBase + noise * waveAmp;
                    if (x === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();
            }

            // 3. Central Telemetry River / Grid Hub (Gold glowing point-clouds)
            const hubX = width * 0.68;
            const hubY = height * 0.5;
            ctx.fillStyle = 'rgba(245, 158, 11, 0.45)';
            for (let j = 0; j < 35; j++) {
                const angle = (j / 35) * Math.PI * 2 + time * 0.2;
                const radius = 60 + Math.sin(time * 2 + j) * 45;
                const px = hubX + Math.cos(angle) * radius * 1.5;
                const py = hubY + Math.sin(angle) * radius;
                ctx.beginPath();
                ctx.arc(px, py, 1.8, 0, Math.PI * 2);
                ctx.fill();
            }

            time += 0.012;
            requestAnimationFrame(render);
        }

        render();
        startAutoSlide();
    })();
</script>
}

