@using dagangOnline.Models
@namespace dagangOnline.Components

<section class="umkm-hero-section" aria-label="Banner Pilihan dagangOnline">
    <div class="umkm-carousel-wrapper" 
         role="region" 
         aria-roledescription="carousel" 
         aria-label="Carousel Utama Informasi UMKM" 
         tabindex="0"
         @onkeydown="OnKeyDown"
         @ontouchstart="OnTouchStart"
         @ontouchend="OnTouchEnd"
         @onmouseenter="OnMouseEnter"
         @onmouseleave="OnMouseLeave">

        <!-- Horizontal Sliding Track ("ada geser-geser nya") -->
        <div class="carousel-sliding-track" style="transform: translateX(-@(CurrentIndex * 100)%);">
            @for (int i = 0; i < Slides.Count; i++)
            {
                var slide = Slides[i];
                var isActive = (i == CurrentIndex);
                var slideNum = i + 1;

                <div class="carousel-slide-item slide-theme-@(i)" 
                     role="group" 
                     aria-roledescription="slide" 
                     aria-label="@($"Slide {slideNum} dari {Slides.Count}: {slide.Title}")"
                     aria-hidden="@(isActive ? "false" : "true")">
                    
                    <div class="slide-content-container">
                        <!-- LEFT COLUMN: Informative Text & CTAs -->
                        <div class="slide-text-col">
                            <div class="slide-badge-row">
                                <span class="slide-eyebrow-badge">@slide.Eyebrow</span>
                                <span class="slide-status-chip">
                                    <span class="status-live-dot" aria-hidden="true"></span>
                                    @slide.SystemStatus
                                </span>
                            </div>

                            <h1 class="slide-title">
                                @((MarkupString)slide.Title.Replace("\n", "<br class='d-none d-lg-block' />"))
                            </h1>

                            <p class="slide-description">
                                @slide.Description
                            </p>

                            <!-- CTAs -->
                            <div class="slide-buttons-cluster">
                                <a href="@slide.PrimaryAction.Href" 
                                   class="btn-slide-primary" 
                                   aria-label="@slide.PrimaryAction.AriaLabel">
                                    <span>@slide.PrimaryAction.Text</span>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </a>

                                <a href="@slide.SecondaryAction.Href" 
                                   class="btn-slide-secondary" 
                                   aria-label="@slide.SecondaryAction.AriaLabel">
                                    <span>@slide.SecondaryAction.Text</span>
                                </a>
                            </div>

                            <!-- Trust & Value Perks -->
                            <div class="slide-perks-row">
                                @if (i == 0)
                                {
                                    <div class="perk-pill">
                                        <span class="perk-icon">🏷️</span>
                                        <span>Daftar 100% Gratis</span>
                                    </div>
                                    <div class="perk-pill">
                                        <span class="perk-icon">⚡</span>
                                        <span>Toko Langsung Buka</span>
                                    </div>
                                    <div class="perk-pill">
                                        <span class="perk-icon">🤝</span>
                                        <span>Bina Mitra Lokal</span>
                                    </div>
                                }
                                else if (i == 1)
                                {
                                    <div class="perk-pill">
                                        <span class="perk-icon">📦</span>
                                        <span>Diskon Ongkir s/d 50%</span>
                                    </div>
                                    <div class="perk-pill">
                                        <span class="perk-icon">🛵</span>
                                        <span>Jemput Paket di Rumah</span>
                                    </div>
                                    <div class="perk-pill">
                                        <span class="perk-icon">📍</span>
                                        <span>Jangkauan Sabang-Merauke</span>
                                    </div>
                                }
                                else if (i == 2)
                                {
                                    <div class="perk-pill">
                                        <span class="perk-icon">🛡️</span>
                                        <span>Proteksi Rekening Escrow</span>
                                    </div>
                                    <div class="perk-pill">
                                        <span class="perk-icon">💳</span>
                                        <span>QRIS & Bank Terlengkap</span>
                                    </div>
                                    <div class="perk-pill">
                                        <span class="perk-icon">⏱️</span>
                                        <span>Cair Dalam 1x24 Jam</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="perk-pill">
                                        <span class="perk-icon">👩‍💼</span>
                                        <span>Mbak Siti Siaga 24 Jam</span>
                                    </div>
                                    <div class="perk-pill">
                                        <span class="perk-icon">🤖</span>
                                        <span>Panduan AI Praktis</span>
                                    </div>
                                    <div class="perk-pill">
                                        <span class="perk-icon">⭐</span>
                                        <span>Kepuasan Pedagang 99%</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: Friendly Visual Display Cards -->
                        <div class="slide-visual-col" aria-hidden="true">
                            @if (i == 0)
                            {
                                <!-- Visual: Toko UMKM & Produk Unggulan -->
                                <div class="friendly-card store-card">
                                    <div class="card-top-tag">
                                        <span class="tag-badge">🏪 Mitra Toko Binaan</span>
                                        <span class="tag-verified">✔ Terverifikasi</span>
                                    </div>
                                    <div class="store-identity">
                                        <div class="store-emoji-badge">🌾</div>
                                        <div class="store-info">
                                            <div class="store-name">Sentra Pangan Alami Nusantara</div>
                                            <div class="store-rating">⭐ 4.9 • 2.800+ Pembeli Puas</div>
                                        </div>
                                    </div>
                                    <div class="store-stats-duo">
                                        <div class="stat-cell">
                                            <span class="stat-number">+45%</span>
                                            <span class="stat-desc">Kenaikan Omzet</span>
                                        </div>
                                        <div class="stat-cell">
                                            <span class="stat-number">4.250</span>
                                            <span class="stat-desc">Pesanan Selesai</span>
                                        </div>
                                    </div>
                                    <div class="store-live-notify">
                                        <span class="pulse-green"></span>
                                        <span>Pesanan baru dikirim: Beras Organik & Madu Hutan</span>
                                    </div>
                                </div>
                            }
                            else if (i == 1)
                            {
                                <!-- Visual: Pengiriman Ekspedisi & Tracking -->
                                <div class="friendly-card delivery-card">
                                    <div class="card-top-tag">
                                        <span class="tag-badge">🚚 Pengiriman Super Cepat</span>
                                        <span class="tag-live">Sedang Berjalan</span>
                                    </div>
                                    <div class="delivery-track-box">
                                        <div class="track-code-row">
                                            <span class="track-code">Resi: DGO-EXP-772910</span>
                                            <span class="track-est">Estimasi: Tiba Besok</span>
                                        </div>
                                        <div class="delivery-steps">
                                            <div class="step-point done">
                                                <div class="dot-marker"></div>
                                                <span>Yogyakarta (Toko)</span>
                                            </div>
                                            <div class="step-connector done"></div>
                                            <div class="step-point current">
                                                <div class="dot-marker"></div>
                                                <span>Jakarta Hub (Transit)</span>
                                            </div>
                                            <div class="step-connector"></div>
                                            <div class="step-point">
                                                <div class="dot-marker"></div>
                                                <span>Bandung (Pelanggan)</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="delivery-bottom-promo">
                                        <span class="promo-icon">🎁</span>
                                        <span>Kupon Potongan Ongkir 50% Aktif</span>
                                    </div>
                                </div>
                            }
                            else if (i == 2)
                            {
                                <!-- Visual: Rekening Bersama & Jaminan Escrow -->
                                <div class="friendly-card escrow-card">
                                    <div class="card-top-tag">
                                        <span class="tag-badge">🛡️ Keamanan Berlapis</span>
                                        <span class="tag-guarantee">Garansi 100%</span>
                                    </div>
                                    <div class="escrow-process-list">
                                        <div class="escrow-item">
                                            <div class="escrow-num">1</div>
                                            <div class="escrow-text">
                                                <strong>Pembeli Membayar</strong>
                                                <span>Dana disimpan aman di rekening bersama</span>
                                            </div>
                                        </div>
                                        <div class="escrow-item">
                                            <div class="escrow-num">2</div>
                                            <div class="escrow-text">
                                                <strong>Penjual Mengirim</strong>
                                                <span>Barang dipacking dan dikirim ke alamat</span>
                                            </div>
                                        </div>
                                        <div class="escrow-item">
                                            <div class="escrow-num">3</div>
                                            <div class="escrow-text">
                                                <strong>Barang Tiba & Dana Cair</strong>
                                                <span>Pencairan otomatis ke rekening penjual</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="payment-badges-row">
                                        <span class="badge-pay">QRIS</span>
                                        <span class="badge-pay">BCA</span>
                                        <span class="badge-pay">BRI</span>
                                        <span class="badge-pay">Mandiri</span>
                                        <span class="badge-pay">BNI</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Visual: Mbak Siti CS & Asisten AI -->
                                <div class="friendly-card support-card">
                                    <div class="card-top-tag">
                                        <span class="tag-badge">💬 Tim Layanan Ramah</span>
                                        <span class="tag-online">● Siaga 24 Jam</span>
                                    </div>
                                    <div class="support-profile">
                                        <div class="support-icons">
                                            <div class="avatar-box cs-face">👩‍💼</div>
                                            <div class="avatar-box ai-face">🤖</div>
                                        </div>
                                        <div>
                                            <div class="support-name">Mbak Siti & Asisten Toko AI</div>
                                            <div class="support-stats">Respon kilat • Siap bantu jualan</div>
                                        </div>
                                    </div>
                                    <div class="dialogue-preview">
                                        <div class="msg-seller">
                                            "Mbak Siti, bagaimana cara ikut bazar promo UMKM akhir pekan?"
                                        </div>
                                        <div class="msg-bot">
                                            "Bisa banget Pak! Tinggal klik menu Kemitraan lalu pilih 'Daftar Promo'. Kami bantu dampingi sampai tokonya tayang ya! 😊"
                                        </div>
                                    </div>
                                    <div class="support-footer-metric">
                                        <span>⭐⭐⭐⭐⭐ Skor Kepuasan Mitra: 99.4%</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Previous Floating Button (Geser Kiri) -->
        <button type="button" 
                class="carousel-arrow-btn arrow-prev" 
                aria-label="Geser ke slide sebelumnya" 
                @onclick="PrevSlide">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>

        <!-- Next Floating Button (Geser Kanan) -->
        <button type="button" 
                class="carousel-arrow-btn arrow-next" 
                aria-label="Geser ke slide berikutnya" 
                @onclick="NextSlide">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>

        <!-- Bottom Controls: Indicators + Pause/Play -->
        <div class="carousel-footer-bar">
            <!-- Dot / Pill Indicators -->
            <div class="carousel-pills-wrap" role="tablist" aria-label="Navigasi Banner">
                @for (int i = 0; i < Slides.Count; i++)
                {
                    var idx = i;
                    var isCurrent = (idx == CurrentIndex);
                    <button type="button" 
                            class="carousel-pill-btn @(isCurrent ? "active" : "")" 
                            role="tab" 
                            aria-selected="@(isCurrent ? "true" : "false")" 
                            aria-label="@($"Buka slide {idx + 1}")" 
                            @onclick="() => GoToSlide(idx)">
                        <span class="pill-dot"></span>
                    </button>
                }
            </div>

            <!-- Play / Pause Toggle Button -->
            <button type="button" 
                    class="carousel-toggle-play-btn" 
                    aria-label="@(IsPaused ? "Mulai putar otomatis" : "Jeda putar otomatis")" 
                    @onclick="TogglePlayPause"
                    title="@(IsPaused ? "Mulai putar otomatis" : "Jeda putar otomatis")">
                @if (IsPaused)
                {
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                }
                else
                {
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <rect x="6" y="4" width="4" height="16"></rect>
                        <rect x="14" y="4" width="4" height="16"></rect>
                    </svg>
                }
            </button>
        </div>
    </div>
</section>
