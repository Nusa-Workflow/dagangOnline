@using dagangOnline.Application.Interfaces
@inject IAiChatService AiChatService
@inject ICatalogService CatalogService
@using System.Text
@using Microsoft.AspNetCore.Components.Web

<div class="chat-widget @(IsOpen ? "open" : "")">
    <div class="chat-widget-header bg-primary text-white p-3 rounded-top d-flex justify-content-between align-items-center cursor-pointer shadow" @onclick="ToggleChat">
        <div class="d-flex align-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-robot me-2" viewBox="0 0 16 16">
                <path d="M6 12.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5ZM3 8.062C3 6.76 4.235 5.765 5.53 5.889a2.89 2.89 0 0 0 4.94 0C11.765 5.765 13 6.76 13 8.062v1.157a.933.933 0 0 1-.765.935c-.845.147-2.34.346-4.235.346-1.895 0-3.39-.2-4.235-.346A.933.933 0 0 1 3 9.219V8.062Zm4.542-.827a.25.25 0 0 0-.217.068l-.92.9a24.767 24.767 0 0 1-1.871-.183.25.25 0 0 0-.068.495c.55.076 1.232.149 2.02.193a.25.25 0 0 0 .189-.071l.754-.736.847 1.71a.25.25 0 0 0 .404.062l.932-.97a25.286 25.286 0 0 0 1.922-.188.25.25 0 0 0-.068-.495c-.538.074-1.208.145-1.98.189a.25.25 0 0 0-.166.076l-.754.785-.842-1.7a.25.25 0 0 0-.182-.135Z"/>
                <path d="M8.5 1.866a1 1 0 1 0-1 0V3h-2A4.5 4.5 0 0 0 1 7.5V8a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1v-.5A4.5 4.5 0 0 0 10.5 3h-2V1.866ZM14 7.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7.5A3.5 3.5 0 0 1 5.5 4h5A3.5 3.5 0 0 1 14 7.5Z"/>
            </svg>
            <h6 class="mb-0 fw-bold">Asisten Belanja (Groq AI)</h6>
        </div>
        <button class="btn btn-sm btn-link text-white p-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16" style="transform: @(IsOpen ? "rotate(0deg)" : "rotate(180deg)"); transition: transform 0.3s;">
                <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
            </svg>
        </button>
    </div>

    @if (IsOpen)
    {
        <div class="chat-widget-body bg-white border border-top-0 d-flex flex-column" style="height: 400px;">
            <div class="chat-messages p-3 flex-grow-1 overflow-auto" id="chat-messages" style="display:flex; flex-direction:column; gap:10px;">
                @foreach (var msg in Messages)
                {
                    <div class="chat-message @(msg.IsUser ? "align-self-end text-end" : "align-self-start text-start")" style="max-width: 85%;">
                        <div class="d-inline-block rounded p-2 px-3 @(msg.IsUser ? "bg-primary text-white" : "bg-light text-dark border")" style="white-space: pre-wrap; text-align: left;">
                            @msg.Content
                        </div>
                    </div>
                }
                @if (IsTyping)
                {
                    <div class="chat-message align-self-start text-start" style="max-width: 85%;">
                        <div class="d-inline-block rounded p-2 px-3 bg-light text-dark border">
                            <span class="spinner-grow spinner-grow-sm text-secondary" role="status" aria-hidden="true"></span>
                            <span class="spinner-grow spinner-grow-sm text-secondary mx-1" role="status" aria-hidden="true"></span>
                            <span class="spinner-grow spinner-grow-sm text-secondary" role="status" aria-hidden="true"></span>
                        </div>
                    </div>
                }
            </div>
            
            <div class="chat-input p-2 border-top bg-light">
                <form @onsubmit="SendMessageAsync" class="d-flex gap-2">
                    <input type="text" class="form-control rounded-pill" placeholder="Tanya tentang produk..." @bind="UserInput" @bind:event="oninput" disabled="@IsTyping" />
                    <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center" disabled="@(string.IsNullOrWhiteSpace(UserInput) || IsTyping)" style="width: 40px; height: 40px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send" viewBox="0 0 16 16">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    }
</div>

<style>
    .chat-widget {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 350px;
        z-index: 1050;
        box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        border-radius: 0.5rem;
        transition: transform 0.3s;
    }
    @@media (max-width: 576px) {
        .chat-widget {
            width: calc(100% - 40px);
            bottom: 20px;
            right: 20px;
        }
    }
    .cursor-pointer {
        cursor: pointer;
    }
    .chat-messages::-webkit-scrollbar {
        width: 6px;
    }
    .chat-messages::-webkit-scrollbar-track {
        background: #f1f1f1; 
    }
    .chat-messages::-webkit-scrollbar-thumb {
        background: #c1c1c1; 
        border-radius: 10px;
    }
    .chat-messages::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8; 
    }
</style>

@code {
    public bool IsOpen { get; set; } = false;
    public string UserInput { get; set; } = "";
    public bool IsTyping { get; set; } = false;

    public List<ChatMessage> Messages { get; set; } = new()
    {
        new ChatMessage { IsUser = false, Content = "Halo! Saya Asisten AI dagangOnline. Ada yang bisa saya bantu terkait produk atau layanan di sini?" }
    };

    public void ToggleChat()
    {
        IsOpen = !IsOpen;
    }

    public async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(UserInput)) return;

        var message = UserInput.Trim();
        UserInput = "";
        
        Messages.Add(new ChatMessage { IsUser = true, Content = message });
        IsTyping = true;
        StateHasChanged();

        // RAG Context Generation
        var products = await CatalogService.Products.GetPublishedProductsAsync(null, 1, 20); // Top 20 products
        var contextBuilder = new StringBuilder();
        foreach (var p in products.Items)
        {
            contextBuilder.AppendLine($"- {p.Name} (Rp {p.Price:N0}): {p.Description}");
        }

        var contextData = contextBuilder.ToString();
        if (string.IsNullOrWhiteSpace(contextData)) 
        {
            contextData = "Tidak ada produk yang dipublikasikan saat ini.";
        }

        try
        {
            var response = await AiChatService.GetChatResponseAsync(message, contextData);
            Messages.Add(new ChatMessage { IsUser = false, Content = response });
        }
        catch (Exception)
        {
            Messages.Add(new ChatMessage { IsUser = false, Content = "Maaf, koneksi saya ke server AI sedang terganggu. Silakan coba lagi." });
        }
        finally
        {
            IsTyping = false;
            StateHasChanged();
        }
    }

    public class ChatMessage
    {
        public bool IsUser { get; set; }
        public string Content { get; set; } = string.Empty;
    }
}
